// Game Template — the smallest honest game.
//
// Arrow keys / WASD move the Player; touching the Coin banks it and the coin
// hops to its next spot. The gameplay is this scene plus the two scripts
// beside it, which is why an exported playground project drops onto this
// crate and runs: nothing here is named in Rust.
//
// The Coin is a Dynamic body with gravity off rather than a Kinematic one:
// rapier reports no intersection between two non-dynamic bodies, so a
// kinematic sensor touched by the kinematic Player would fire nothing.
SceneData(
    name: "Game Template",

    physics: Some(PhysicsSettings(
        gravity: (0.0, 0.0),
        pixels_per_meter: 100.0,
        timestep: 0.016666668,
    )),

    prefabs: {},

    entities: [
        EntityData(
            name: Some("Camera"),
            components: [
                Transform2D(position: (0.0, 0.0)),
                Camera2D(is_main_camera: true, viewport_size: (800.0, 600.0)),
            ],
        ),

        EntityData(
            name: Some("Background"),
            components: [
                Transform2D(position: (0.0, 0.0), scale: (12.0, 9.0)),
                Sprite(
                    texture: "#white",
                    color: (0.0, 0.0, 0.0, 1.0),
                    depth: -100.0,
                ),
            ],
        ),

        EntityData(
            name: Some("Player"),
            components: [
                Transform2D(position: (0.0, 0.0), scale: (0.25, 0.25)),
                Sprite(
                    texture: "images/ball_8px.png",
                    color: (0.3, 0.9, 1.0, 1.0),
                    emissive: 2.5,
                ),
                RigidBody(
                    body_type: Kinematic,
                    can_rotate: false,
                ),
                Collider(
                    shape: Circle(radius: 10.0),
                    friction: 0.0,
                ),
                Scripts([(
                    script_id: "player",
                    source_path: "scripts/player.rhai",
                    params: {},
                )]),
            ],
        ),

        // The walls carry a fixed grey of their own: nothing recolors a
        // scene-spawned entity, and chaos reaches the grid and particles only.
        EntityData(
            name: Some("Top Wall"),
            components: [
                Transform2D(position: (0.0, 290.0), scale: (10.0, 0.25)),
                Sprite(texture: "#white", color: (0.35, 0.35, 0.42, 1.0), emissive: 0.6),
                RigidBody(body_type: Static),
                Collider(shape: Box(half_extents: (400.0, 10.0)), friction: 0.0),
            ],
        ),

        EntityData(
            name: Some("Bottom Wall"),
            components: [
                Transform2D(position: (0.0, -290.0), scale: (10.0, 0.25)),
                Sprite(texture: "#white", color: (0.35, 0.35, 0.42, 1.0), emissive: 0.6),
                RigidBody(body_type: Static),
                Collider(shape: Box(half_extents: (400.0, 10.0)), friction: 0.0),
            ],
        ),

        EntityData(
            name: Some("Left Wall"),
            components: [
                Transform2D(position: (-390.0, 0.0), scale: (0.25, 7.5)),
                Sprite(texture: "#white", color: (0.35, 0.35, 0.42, 1.0), emissive: 0.6),
                RigidBody(body_type: Static),
                Collider(shape: Box(half_extents: (10.0, 300.0)), friction: 0.0),
            ],
        ),

        EntityData(
            name: Some("Right Wall"),
            components: [
                Transform2D(position: (390.0, 0.0), scale: (0.25, 7.5)),
                Sprite(texture: "#white", color: (0.35, 0.35, 0.42, 1.0), emissive: 0.6),
                RigidBody(body_type: Static),
                Collider(shape: Box(half_extents: (10.0, 300.0)), friction: 0.0),
            ],
        ),

        EntityData(
            name: Some("Coin"),
            components: [
                Transform2D(position: (200.0, 150.0), scale: (0.25, 0.25)),
                Sprite(
                    texture: "images/ball_8px.png",
                    color: (1.0, 0.85, 0.2, 1.0),
                    emissive: 2.0,
                ),
                RigidBody(
                    body_type: Dynamic,
                    gravity_scale: 0.0,
                    can_rotate: false,
                ),
                Collider(
                    shape: Circle(radius: 12.0),
                    is_sensor: true,
                ),
                Scripts([(
                    script_id: "coin",
                    source_path: "scripts/coin.rhai",
                    params: {},
                )]),
            ],
        ),
    ],
)
