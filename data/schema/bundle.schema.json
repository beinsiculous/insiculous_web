{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortknight.local/schema/bundle.schema.json",
  "title": "FortKnight bundle",
  "description": "Everything the app needs in one object: canonical data plus derived views. Generated by scripts/build.py.",
  "type": "object",
  "properties": {
    "buildInfo": {
      "type": "object",
      "properties": {
        "buildHash": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "integer"
        },
        "builtFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "buildHash",
        "schemaVersion"
      ],
      "additionalProperties": false
    },
    "meta": {
      "type": "object"
    },
    "seasons": {
      "type": "object"
    },
    "days": {
      "type": "object"
    },
    "blocks": {
      "type": "object"
    },
    "categories": {
      "type": "object"
    },
    "activities": {
      "type": "object"
    },
    "menus": {
      "type": "object"
    },
    "weights": {
      "type": [
        "object",
        "null"
      ]
    },
    "derived": {
      "type": "object",
      "properties": {
        "menuByDay": {
          "type": "object"
        },
        "planByDay": {
          "type": "object"
        },
        "allocations": {
          "type": "object"
        },
        "defaultImport": {
          "type": "object",
          "description": "The data set as an import document (data/schema/import.schema.json, version 2) — the example document: empty and readable on the neutral data, the workbook itself on the workbook overlay (applied on the Assistant page)."
        }
      },
      "required": [
        "menuByDay",
        "planByDay",
        "allocations",
        "defaultImport"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "buildInfo",
    "meta",
    "seasons",
    "days",
    "blocks",
    "categories",
    "activities",
    "menus",
    "derived"
  ],
  "additionalProperties": false
}
