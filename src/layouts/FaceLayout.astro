---
import "../styles/faces.css";
import ProfileSwitcher from "../components/ProfileSwitcher.astro";
import AccessibilityBootScript from "../components/AccessibilityBootScript.astro";
import AccessibilityControls from "../components/AccessibilityControls.astro";
import bundle from "../../build/fortknight.bundle.json";
import { withBase } from "../lib/paths.js";
import { FACES, FACE_IDS, PROFILE_PATH, STUDIO, faceNav, facePath, studioPath } from "../lib/faces.js";
import { KOFI_URL, KOFI_LABEL, KOFI_TITLE } from "../lib/site-links.js";

// The layout of the site's two faces (docs/app.md), and of those two only: every page rendered here belongs to
// "fortknight" or "forkknife", so `face` is required. Its menu is Overview, the face's own building page (Spoon Feed /
// Build), Questionnaire, Assistant. Each face brings its own skin (FACES[face].theme), so the two read as different
// sites. The switcher sits left of the brand: the Be Insiculous logo back out to the studio site first, then the other
// face's logo. The profile dropdown and ⚙ Profile only show once a profile is saved on this device.
// The Profile page the two faces share is NOT here — it belongs to beinsiculous.com and is a studio page on
// BaseLayout (src/pages/profile.astro).
const { title, face } = Astro.props;
const currentFace = FACES[face];
const otherFaces = FACE_IDS.filter((faceId) => faceId !== face).map((faceId) => FACES[faceId]);
const navItems = faceNav(face).map((item) => ({ ...item, href: facePath(face, item.path) }));
const profileHref = withBase(PROFILE_PATH);
const pathname = Astro.url.pathname;
function isActive(item) {
  if (item.exact) return pathname === item.href || pathname.startsWith(`${item.href}days/`); // the day pages belong to the Overview's grid
  return pathname.startsWith(item.href);
}
const profileActive = pathname.startsWith(profileHref);
const brandLabel = `${currentFace.logo} ${currentFace.label}`;
const theme = currentFace.theme;
// Each face gets its own tab icon — an emoji drawn into an inline SVG, so there is no file to ship.
const favicon = `data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>${currentFace.favicon}</text></svg>`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · {brandLabel}</title>
  <link rel="icon" href={favicon} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="stylesheet" href={withBase("app/shared/themes.css")} />
  <script is:inline define:vars={{ theme }}>
    // The page's face decides its skin; set before first paint so the base palette never shows.
    document.documentElement.dataset.theme = theme;
  </script>
  <AccessibilityBootScript />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-nav">
    {/* "Site links" rather than "Switch app": the row carries the tip jar as well as the two faces
        now. The ☕ sits inside this nav rather than beside it because ForkKnife's theme moves the
        whole switcher (order/gap, faces.css) — a sibling would detach from the row on that face. */}
    <nav class="face-switch" aria-label="Site links">
      <a class="face-link face-home" href={studioPath()} title={`${STUDIO.label} — the studio site`} aria-label={STUDIO.label}>{STUDIO.logo}</a>
      {otherFaces.map((other) => (
        <a class="face-link" href={facePath(other.id)} title={`${other.label} — ${other.blurb}`} aria-label={other.label}>{other.logo}</a>
      ))}
      <a class="face-link" href={KOFI_URL} title={KOFI_TITLE} aria-label={KOFI_LABEL} target="_blank" rel="noopener noreferrer">☕</a>
    </nav>
    <a class="brand" href={facePath(face)}>
      <span class="logo" aria-hidden="true">{currentFace.logo}</span> {currentFace.label}
    </a>
    <nav class="nav-links">
      {navItems.map((item) => (
        <a class={`nav-link${isActive(item) ? " active" : ""}`} href={item.href} aria-label={item.label}>
          <span class="nav-full">{item.label}</span>{item.shortLabel && <span class="nav-short">{item.shortLabel}</span>}
        </a>
      ))}
    </nav>
    <AccessibilityControls />
    <ProfileSwitcher questionnaireHref={facePath(face, "questionnaire/")}>
      <a class={`nav-link${profileActive ? " active" : ""}`} href={profileHref}>⚙ Profile</a>
    </ProfileSwitcher>
  </header>
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <footer class="site-footer muted">
    Times shown in {bundle.meta.timezone} · <a href={withBase("accessibility/")}>Accessibility</a>
  </footer>
  <script define:vars={{ buildHash: bundle.buildInfo.buildHash, timezone: bundle.meta.timezone }}>
    console.log(`beinsiculous bundle ${buildHash} · ${timezone}`);
  </script>
</body>
</html>
