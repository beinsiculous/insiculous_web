---
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Be Insiculous — independent game studio building games and a Rust 2D engine.',
} = Astro.props;

// FortKnight and ForkKnife are the two planner faces that live on this domain under their own
// layout and their own skin (src/layouts/FaceLayout.astro); their pages link back here.
const nav = [
  { href: '/', label: 'Home' },
  { href: '/games/', label: 'Games' },
  { href: '/devlog/', label: 'Devlog' },
  { href: '/engine/', label: 'Engine' },
  { href: '/fortknight/', label: 'FortKnight' },
  { href: '/forkknife/', label: 'ForkKnife' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav class="container">
        <a href="/" class="wordmark">be_insiculous<span class="cursor">▌</span></a>
        <ul>
          {
            nav.map(({ href, label }) => (
              <li>
                <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer>
      <div class="container">
        <p>
          © {new Date().getFullYear()} Be Insiculous — games &amp; engine by one
          stubborn developer.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  header {
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    position: sticky;
    top: 0;
    backdrop-filter: blur(6px);
    z-index: 10;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text-bright);
    font-size: 1.05rem;
  }

  .wordmark:hover {
    text-decoration: none;
    color: var(--accent);
  }

  .cursor {
    color: var(--accent);
    animation: blink 1.2s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  ul {
    display: flex;
    gap: 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  ul a {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text);
  }

  ul a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  ul a[aria-current='page'] {
    color: var(--accent);
  }

  ul a[aria-current='page']::before {
    content: '[';
  }

  ul a[aria-current='page']::after {
    content: ']';
  }

  main {
    padding-top: 3rem;
    padding-bottom: 4rem;
    min-height: 70vh;
  }

  footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0 2rem;
  }

  footer p {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    margin: 0;
  }
</style>
