---
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import AccessibilityBootScript from '../components/AccessibilityBootScript.astro';
import AccessibilityControls from '../components/AccessibilityControls.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Be Insiculous — independent game studio building games and a Rust 2D engine.',
} = Astro.props;

// FortKnight and ForkKnife are the two planner faces that live on this domain under their own
// layout and their own skin (src/layouts/FaceLayout.astro); their pages link back here.
const nav = [
  { href: '/', label: 'Home' },
  { href: '/games/', label: 'Games' },
  { href: '/devlog/', label: 'Devlog' },
  { href: '/engine/', label: 'Engine' },
  { href: '/fortknight/', label: 'FortKnight' },
  { href: '/forkknife/', label: 'ForkKnife' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <AccessibilityBootScript />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <nav class="container" aria-label="Main">
        <a href="/" class="wordmark">be_insiculous<span class="cursor" aria-hidden="true">▌</span></a>
        <div class="nav-side">
          <AccessibilityControls />
          <details class="menu">
          <summary>
            <span aria-hidden="true">☰</span><span class="visually-hidden">Menu</span>
          </summary>
          <ul>
            {
              nav.map(({ href, label }) => (
                <li>
                  <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
          </details>
        </div>
      </nav>
    </header>

    <main class="container" id="main" tabindex="-1">
      <slot />
    </main>

    <footer>
      <div class="container">
        <p>
          © {new Date().getFullYear()} Be Insiculous — games &amp; engine by one
          stubborn developer. · <a href="/accessibility/">Accessibility</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  header {
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    position: sticky;
    top: 0;
    backdrop-filter: blur(6px);
    z-index: 10;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }

  .nav-side {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text-bright);
    font-size: 1.05rem;
  }

  .wordmark:hover {
    text-decoration: none;
    color: var(--accent);
  }

  .cursor {
    color: var(--accent);
    animation: blink 1.2s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  /* The menu is a native disclosure, so it needs no JavaScript: the ☰ opens it, Escape closes it, the keyboard
     reaches it, and every navigation resets it because each page is a fresh document. The button only exists on a
     phone; above that breakpoint the list is the plain row it has always been. */
  .menu {
    /* min-width: 0 lets the row shrink; without it the six links set an unshrinkable min-content floor and the
       whole page scrolls sideways. */
    min-width: 0;
  }

  summary {
    display: none; /* no button at desktop widths */
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  ul {
    display: flex;
    gap: 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* A closed <details> hides its content, and browsers do it in two different ways: an older UA rule on the
     children, and newer Chrome's content-visibility on the generated ::details-content box. Override both, so the
     bar reads as an ordinary row here whether the element happens to be open or not. */
  @media (min-width: 40.0625rem) {
    .menu > ul {
      display: flex;
    }

    .menu::details-content {
      content-visibility: visible;
      display: contents;
    }
  }

  /* Phone: the six links do not fit 390px, so they fold behind the ☰ and drop as a full-width panel under the
     header. The panel is positioned against <header>, which is sticky and therefore the containing block, so it
     spans the viewport rather than the container's column. */
  @media (max-width: 40rem) {
    summary {
      display: grid;
      place-items: center;
      min-width: 44px;
      min-height: 44px;
      margin-right: -0.35rem;
      font-size: 1.35rem;
      color: var(--text);
    }

    .menu[open] > summary {
      color: var(--accent);
    }

    .menu > ul {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      flex-direction: column;
      gap: 0;
      padding: 0.25rem 1.25rem 0.6rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }

    ul a {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
  }

  ul a {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text);
  }

  ul a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  ul a[aria-current='page'] {
    color: var(--accent);
  }

  ul a[aria-current='page']::before {
    content: '[';
  }

  ul a[aria-current='page']::after {
    content: ']';
  }

  main {
    padding-top: 3rem;
    padding-bottom: 4rem;
    min-height: 70vh;
  }

  @media (max-width: 40rem) {
    main {
      padding-top: 1.75rem;
      padding-bottom: 2.5rem;
    }
  }

  footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0 2rem;
  }

  footer p {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    margin: 0;
  }
</style>
