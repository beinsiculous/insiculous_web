---
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import AccessibilityBootScript from '../components/AccessibilityBootScript.astro';
import AccessibilityControls from '../components/AccessibilityControls.astro';
import { KOFI_URL, KOFI_LABEL, KOFI_TITLE } from '../lib/site-links.js';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Be Insiculous — an Artificial Intelligence Development Studio: a Rust game engine and the games that run on it, and planning software driven by your own AI assistant.',
} = Astro.props;

// FortKnight is the planner face that lives on this domain under its own
// layout and its own skin (src/layouts/FaceLayout.astro); its pages link back here.
const nav = [
  { href: '/', label: 'Home' },
  { href: '/games/', label: 'Games' },
  { href: '/achievements/', label: 'Achievements' },
  { href: '/devlog/', label: 'Devlog' },
  { href: '/engine/', label: 'Engine' },
  { href: '/fortknight/', label: 'FortKnight' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/jpeg" href="/beinsiculous.jpg" />
    <link rel="apple-touch-icon" href="/beinsiculous.jpg" />
    <meta name="description" content={description} />
    <AccessibilityBootScript />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(currentPath, Astro.site)} />
    <link rel="canonical" href={new URL(currentPath, Astro.site)} />
    <meta property="og:image" content={new URL('/beinsiculous.jpg', Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Be Insiculous devlog" href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <nav class="container" aria-label="Main">
        <a href="/" class="wordmark">be_insiculous<span class="cursor" aria-hidden="true">▌</span></a>
        <div class="nav-side">
          <AccessibilityControls />
          <details class="menu">
          <summary>
            <span aria-hidden="true">☰</span><span class="visually-hidden">Menu</span>
          </summary>
          <ul>
            {
              nav.map(({ href, label }) => (
                <li>
                  <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
                    {label}
                  </a>
                </li>
              ))
            }
            {/* The tip jar rides in the menu list so it folds into the ☰ panel with everything else,
                the way the ☕ does in the faces' switcher. It is not in the `nav` array above: that
                array is internal hrefs the aria-current test runs over, and this one leaves the site. */}
            <li>
              <a
                class="coffee-link"
                href={KOFI_URL}
                title={KOFI_TITLE}
                aria-label={KOFI_LABEL}
                target="_blank"
                rel="noopener noreferrer">☕</a>
            </li>
          </ul>
          </details>
        </div>
      </nav>
    </header>

    <main class="container" id="main" tabindex="-1">
      <slot />
    </main>

    <footer>
      <div class="container">
        <p>
          © {new Date().getFullYear()} Be Insiculous — built with AI, for AI, and
          the humans in the loop. · <a href="/accessibility/">Accessibility</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  header {
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    position: sticky;
    top: 0;
    backdrop-filter: blur(6px);
    z-index: 10;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }

  .nav-side {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text-bright);
    font-size: 1.05rem;
  }

  .wordmark:hover {
    text-decoration: none;
    color: var(--accent);
  }

  .cursor {
    color: var(--accent);
    animation: blink 1.2s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  /* The menu is a native disclosure, so it needs no JavaScript: the ☰ toggles it, Enter and Space toggle it from
     the keyboard, and every navigation resets it because each page is a fresh document. It does NOT close on
     Escape — this comment used to claim it did, and a test in Chrome says otherwise with focus on the summary, on
     a panel link and on the body. A disclosure is not a modal and does not owe you one; closing it needs the ☰
     again. The button only exists on a phone; above that breakpoint the list is the plain row it has always been.
     FaceLayout.astro carries the twin of this menu, with its rules in src/styles/faces.css. */
  .menu {
    /* min-width: 0 lets the row shrink; without it the six links set an unshrinkable min-content floor and the
       whole page scrolls sideways. */
    min-width: 0;
  }

  summary {
    display: none; /* no button at desktop widths */
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  ul {
    display: flex;
    gap: 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* global.css sets no emoji stack the way faces.css does for .face-link, so the cup needs its own
     or it renders in the mono face. src/pages/devlog/index.astro styles a .coffee-link beside the
     listing's h1 the same way; both are Astro-scoped, so they cannot reach each other — if this
     one changes, look at that one.
     `ul a.coffee-link` and not a bare `.coffee-link`, which lost to `ul a` above: Astro scopes every
     compound in a selector, so that rule ships as `ul[data-astro-cid-…] a[data-astro-cid-…]` and
     carries two attributes plus two elements, out-specifying one class plus one attribute. Scoped
     selectors are not as weak as they read in this file. */
  ul a.coffee-link {
    font-family: 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
    font-size: 1.2rem;
    line-height: 1;
    opacity: 0.8;
  }

  ul a.coffee-link:hover {
    opacity: 1;
  }

  /* A closed <details> hides its content, and browsers do it in two different ways: an older UA rule on the
     children, and newer Chrome’s content-visibility on the generated ::details-content box. Override both, so the
     bar reads as an ordinary row here whether the element happens to be open or not. */
  @media (min-width: 40rem) {
    /* Wrap: six links do not fit the moment the phone panel stops, only once the viewport is wide
       enough for all of them in a row. Without this the header overflowed from 641px upwards. */
    .menu > ul {
      display: flex;
      flex-wrap: wrap;
    }

    .menu::details-content {
      content-visibility: visible;
      display: contents;
    }
  }

  /* Phone: the six links do not fit 390px, so they fold behind the ☰ and drop as a full-width panel under the
     header. The panel is positioned against <header>, which is sticky and therefore the containing block, so it
     spans the viewport rather than the container’s column. */
  @media (max-width: 40rem) {
    summary {
      display: grid;
      place-items: center;
      min-width: 44px;
      min-height: 44px;
      margin-right: -0.35rem;
      font-size: 1.35rem;
      color: var(--text);
    }

    .menu[open] > summary {
      color: var(--accent);
    }

    .menu > ul {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      flex-direction: column;
      gap: 0;
      padding: 0.25rem 1.25rem 0.6rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }

    ul a {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
  }

  ul a {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text);
  }

  ul a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  ul a[aria-current='page'] {
    color: var(--accent);
  }

  ul a[aria-current='page']::before {
    content: '[';
  }

  ul a[aria-current='page']::after {
    content: ']';
  }

  main {
    padding-top: 3rem;
    padding-bottom: 4rem;
    min-height: 70vh;
  }

  @media (max-width: 40rem) {
    main {
      padding-top: 1.75rem;
      padding-bottom: 2.5rem;
    }
  }

  footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0 2rem;
  }

  footer p {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    margin: 0;
  }
</style>
