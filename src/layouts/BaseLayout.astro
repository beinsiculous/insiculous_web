---
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import AccessibilityBootScript from '../components/AccessibilityBootScript.astro';
import AccessibilityControls from '../components/AccessibilityControls.astro';
import ProfileSwitcher from '../components/ProfileSwitcher.astro';
import { KOFI_URL, KOFI_LABEL, KOFI_TITLE } from '../lib/site-links.js';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Be Insiculous — an Artificial Intelligence Development Studio: a Rust game engine and the games that run on it, and planning software driven by your own AI assistant.',
} = Astro.props;

// FortKnight is the planner face that lives on this domain under its own
// layout and its own skin (src/layouts/FaceLayout.astro); its pages link back here.
//
// Text destinations only. The two icon links — ⚙️ Profile and the ☕ tip jar — are not here: they are
// the icon row at the foot of the panel, the studio's twin of the face's .face-switch, and neither is
// a word in this list.
const nav = [
  { href: '/', label: 'Home' },
  { href: '/games/', label: 'Games' },
  { href: '/achievements/', label: 'Achievements' },
  { href: '/devlog/', label: 'Devlog' },
  { href: '/engine/', label: 'Engine' },
  { href: '/fortknight/', label: 'FortKnight' },
];

// The studio's way in to /profile/. The page is shared with the face and is a studio page on this
// layout, yet until 2026-08-31 nothing on a studio page linked to it — its only entrance was
// FortKnight's ☰. Unlike the face's, it does NOT hide until a profile is saved: the face wraps its
// link in ProfileSwitcher, and here a first-time visitor is exactly who needs the way in —
// /profile/'s empty state names the two places that create a profile.
const PROFILE_HREF = '/profile/';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/jpeg" href="/beinsiculous.jpg" />
    <link rel="apple-touch-icon" href="/beinsiculous.jpg" />
    <meta name="description" content={description} />
    <AccessibilityBootScript />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(currentPath, Astro.site)} />
    <link rel="canonical" href={new URL(currentPath, Astro.site)} />
    <meta property="og:image" content={new URL('/beinsiculous.jpg', Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Be Insiculous devlog" href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <nav class="container" aria-label="Main">
        <a href="/" class="wordmark">be_insiculous<span class="cursor" aria-hidden="true">▌</span></a>
        <div class="nav-side">
          <AccessibilityControls />
          <details class="menu">
            <summary>
              <span aria-hidden="true">☰</span><span class="visually-hidden">Menu</span>
            </summary>
            {/* The panel wrapper is what the phone positions and what desktop dissolves with
                display: contents. The list used to be that element itself; the icon row needs a
                sibling to sit beside, and this is the same shape FaceLayout.astro uses. */}
            <div class="menu-panel">
              <ul>
                {
                  nav.map(({ href, label }) => (
                    <li>
                      <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
                        {label}
                      </a>
                    </li>
                  ))
                }
              </ul>
              {/* The switcher, in the same slot the face keeps it: after the destinations, before the
                  icons. It renders nothing until a profile is saved on this device, so a first-time
                  visitor sees the bar it has always had.
                  It is passed no slot content, and that is the one place this parts from FaceLayout.
                  The face passes its ⚙ Profile link into the slot because its own icon row is spent
                  on the 💧 back out to the studio. The studio has nowhere to go back out to, so its
                  icon row leads with the gear instead — and a second link to /profile/ in the slot
                  would be the same destination twice, a step apart.
                  This is now the only switcher on a studio page: /profile/ used to render its own,
                  and two would ship duplicate navProfile ids and fail the axe gate. */}
              <ProfileSwitcher />
              {/* The studio's twin of the face's .face-switch (FaceLayout.astro, rules in
                  src/styles/faces.css). Same two roles in the same two places: the one that
                  navigates is large and leads on the left, the tip jar is small and pushed to the
                  far end by an auto margin, where it reads as an aside rather than a second
                  destination. The auto margin does that without touching source order, so the tab
                  sequence still matches the paint (WCAG 2.4.3).
                  Both are icon-only, so each carries its own aria-label — the emoji is the whole
                  link, and an unlabelled one would announce as its character name or its href. */}
              <nav class="site-icons" aria-label="Site links">
                <a
                  class="icon-link icon-profile"
                  href={PROFILE_HREF}
                  title="Profile"
                  aria-label="Profile"
                  aria-current={isActive(PROFILE_HREF) ? 'page' : undefined}>⚙️</a>
                <a
                  class="icon-link icon-kofi"
                  href={KOFI_URL}
                  title={KOFI_TITLE}
                  aria-label={KOFI_LABEL}
                  target="_blank"
                  rel="noopener noreferrer">☕</a>
              </nav>
            </div>
          </details>
        </div>
      </nav>
    </header>

    <main class="container" id="main" tabindex="-1">
      <slot />
    </main>

    <footer>
      <div class="container">
        <p>
          © {new Date().getFullYear()} Be Insiculous — built with AI, for AI, and
          the humans in the loop. · <a href="/accessibility/">Accessibility</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  header {
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    position: sticky;
    top: 0;
    backdrop-filter: blur(6px);
    z-index: 10;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }

  .nav-side {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text-bright);
    font-size: 1.05rem;
  }

  .wordmark:hover {
    text-decoration: none;
    color: var(--accent);
  }

  .cursor {
    color: var(--accent);
    animation: blink 1.2s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  /* The menu is a native disclosure, so it needs no JavaScript: the ☰ toggles it, Enter and Space toggle it from
     the keyboard, and every navigation resets it because each page is a fresh document. It does NOT close on
     Escape — this comment used to claim it did, and a test in Chrome says otherwise with focus on the summary, on
     a panel link and on the body. A disclosure is not a modal and does not owe you one; closing it needs the ☰
     again. The button only exists on a phone; above that breakpoint the list is the plain row it has always been.
     FaceLayout.astro carries the twin of this menu, with its rules in src/styles/faces.css. */
  .menu {
    /* min-width: 0 lets the row shrink; without it the six links set an unshrinkable min-content floor and the
       whole page scrolls sideways. */
    min-width: 0;
  }

  summary {
    display: none; /* no button at desktop widths */
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* 0.9rem, not the 1.4rem this carried before the switcher joined the bar. The studio's header lives
     inside .container (68rem) while the face's nav spans the viewport, so this bar has about 200px less
     to spend — and at 1.4rem the six links wrapped to three rows the moment the switcher took its 233px.
     Measured at 1280px: 1.4rem gives a 516x78 list, 0.9rem a single row. */
  ul {
    display: flex;
    gap: 0.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The icon row: the studio's twin of .face-switch / .face-link in src/styles/faces.css. The sizes
     are that file's, so the ⚙️ matches the 💧 the face wears in the same slot — 1.15rem in the bar,
     1.75rem in the panel, with the tip jar left small either way.
     global.css sets no emoji stack the way faces.css does for .face-link, so these need their own or
     they render in the mono face. src/pages/devlog/index.astro styles a .coffee-link beside the
     listing's h1 the same way; both are Astro-scoped, so they cannot reach each other — if this one
     changes, look at that one. */
  .site-icons {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .icon-link {
    font-family: 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
    font-size: 1.15rem;
    line-height: 1;
    padding: 0.15rem 0.4rem;
    border-radius: 999px;
    opacity: 0.8;
  }

  .icon-link:hover {
    opacity: 1;
    text-decoration: none;
  }

  /* The list marks the page you are on with brackets around the word; an icon has no word to bracket,
     so the current page shows as a fully-opaque icon on the accent ring instead. */
  .icon-link[aria-current='page'] {
    opacity: 1;
    outline: 1px solid var(--accent);
  }

  /* A closed <details> hides its content, and browsers do it in two different ways: an older UA rule on the
     children, and newer Chrome’s content-visibility on the generated ::details-content box. Override both, so the
     bar reads as an ordinary row here whether the element happens to be open or not. */
  @media (width >= 66rem) {
    /* Kept as a safety net rather than a working rule: above the fold breakpoint the row is measured to
       fit on one line, and this is what stops an overflow if it ever stops fitting. */
    .menu-panel > ul {
      display: flex;
      flex-wrap: wrap;
    }

    /* Both the disclosure and its panel dissolve, so the list and the icon row become flex items of
       .nav-side and the bar is one flat row again — the same two lines FaceLayout.astro uses. */
    .menu,
    .menu-panel {
      display: contents;
    }

    .menu::details-content {
      content-visibility: visible;
      display: contents;
    }
  }

  /* Folded: the links do not fit, so they drop behind the ☰ as a full-width panel under the header. The
     panel is positioned against <header>, which is sticky and therefore the containing block, so it spans
     the viewport rather than the container’s column.
     66rem (1056px), not the 40rem this used to be, and not the 40rem the rest of global.css uses for
     phones. The bar carries the profile switcher now, and its 233px is the difference between six links
     on one row and six links on three. Measured on the built page with a profile seeded: one row from
     1050px up, three rows at 1049 — 66rem takes that threshold and a little slack. Below it the header is
     a flat 82px at every width; at the old breakpoint the 641–1049 band was a 100–143px header of stacked
     links, which is the thing a fold breakpoint exists to prevent. FaceLayout.astro reaches for the same
     answer at its own width.
     Range syntax (`width >= 66rem` / `width < 66rem`) rather than the min-width/max-width pair faces.css
     used until #25, because that pair cannot express a clean boundary and this layout proved it: at 40rem/40rem both
     queries match at exactly the breakpoint, and the two blocks set different properties, so both applied —
     measured at 1056px, a 294px header showing the ☰ AND all six links at once. Splitting them to
     66rem/66.0625rem only trades that for the other half of the bug faces.css already documents: a
     fractional viewport in the gap (routine with display scaling or zoom) matches NEITHER, the ☰ is hidden,
     and the closed <details> keeps the links hidden too, so no page is reachable. `>=` and `<` are exact
     complements — no overlap, no gap, at any fractional width. */
  @media (width < 66rem) {
    summary {
      display: grid;
      place-items: center;
      min-width: 44px;
      min-height: 44px;
      margin-right: -0.35rem;
      font-size: 1.35rem;
      color: var(--text);
    }

    .menu[open] > summary {
      color: var(--accent);
    }

    /* The wrapper is the positioned panel now, not the list — the list is one of its two children. */
    .menu-panel {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      padding: 0.25rem 1.25rem calc(0.6rem + env(safe-area-inset-bottom));
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      max-height: calc(100vh - 100%);
      overflow-y: auto; /* a long panel scrolls rather than running off screen */
    }

    .menu-panel > ul {
      flex-direction: column;
      gap: 0;
    }

    ul a {
      display: flex;
      align-items: center;
      min-height: 44px;
    }

    /* The panel reads top to bottom as "the site", then "you and the tip jar" — the markup's order,
       so nothing here reorders anything. The rule separates the icons from the destinations, and the
       two stay a row rather than a column: they are icons, and two emoji stacked read as a list of
       nothing. Same reasoning, same rule, as faces.css's .menu-panel .face-switch. */
    .site-icons {
      gap: 0.5rem;
      padding-top: 0.6rem;
      margin-top: 0.2rem;
      border-top: 1px solid var(--border);
    }

    /* The one that navigates is big enough to hit without looking; the tip jar keeps the small size
       and an auto margin puts it at the far end. */
    .icon-link:not(.icon-kofi) {
      font-size: 1.75rem;
      padding: 0.15rem 0.5rem;
    }

    .icon-kofi {
      margin-left: auto;
    }
  }

  /* Keyed to the pointer, not the viewport: a touchscreen laptop needs a 44px target in the flat bar
     too, and a narrow desktop window does not. faces.css closes with the same block. */
  @media (pointer: coarse) {
    .icon-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
    }
  }

  ul a {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text);
  }

  ul a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  ul a[aria-current='page'] {
    color: var(--accent);
  }

  ul a[aria-current='page']::before {
    content: '[';
  }

  ul a[aria-current='page']::after {
    content: ']';
  }

  main {
    padding-top: 3rem;
    padding-bottom: 4rem;
    min-height: 70vh;
  }

  @media (max-width: 40rem) {
    main {
      padding-top: 1.75rem;
      padding-bottom: 2.5rem;
    }
  }

  footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0 2rem;
  }

  footer p {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    margin: 0;
  }
</style>
