---
interface Props {
  status: 'playable' | 'alpha' | 'in-development' | 'prototype';
}

const { status } = Astro.props;

const labels: Record<Props['status'], string> = {
  playable: 'playable',
  alpha: 'alpha · desktop',
  'in-development': 'in development',
  prototype: 'prototype',
};
---

<span class:list={['badge', status]}>{labels[status]}</span>

<style>
  .badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  .playable {
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
  }

  .alpha {
    border: 1px solid var(--accent);
    color: var(--accent);
  }

  .in-development {
    border: 1px solid var(--accent-dim);
    color: var(--accent);
    background: var(--accent-glow);
  }

  .prototype {
    border: 1px solid var(--border-bright);
    color: var(--text-dim);
  }
</style>
