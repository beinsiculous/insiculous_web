---
/**
 * Embed area for the Web Playground WASM build.
 *
 * Renders the WebGPU gate, boot status (#game-loading), persistence banner
 * (#playground-banner), canvas placeholder (#game-canvas), project controls,
 * command API console, and keyboard shortcuts.
 *
 * Exactly ONE playground embed per page: the engine binds to fixed DOM IDs
 * and module singletons.
 */
interface Props {
  src?: string;
  width?: number;
  height?: number;
}

const { src = '/playground/v1/game.js', width = 1280, height = 800 } = Astro.props;
---

<div class="playground-embed" data-wasm-src={src}>
  <div class="banner-region">
    <p id="playground-banner" class="playground-banner" role="alert"></p>
    <div id="import-rejection-actions" class="banner-actions"></div>
    <div id="conflicted-actions" class="banner-actions"></div>
  </div>
  <p id="game-loading" class="status" role="status">Checking WebGPU…</p>

  <div class="toolbar" role="group" aria-label="Playground project controls">
    <div class="field-group">
      <label for="project-select">Project</label>
      <select id="project-select" name="project" disabled>
        <option value="examples">Examples</option>
      </select>
    </div>
    <div class="reset-group">
      <button type="button" id="reset-button" class="btn-reset" disabled hidden>
        Reset to bundled
      </button>
      <span id="reset-note" class="reset-note" hidden></span>
    </div>
    <div class="archive-group">
      <button type="button" id="export-button" class="btn-toolbar" disabled>
        Export project
      </button>
      <label for="import-input" class="label-import">Import project</label>
      <input
        type="file"
        id="import-input"
        class="input-file"
        accept=".zip,application/zip"
        disabled
      />
    </div>
  </div>

  <canvas
    id="game-canvas"
    width={width}
    height={height}
    tabindex="0"
    role="img"
    aria-label="Web Playground — scene editor canvas; focus it to edit and play"
  >
    The Web Playground runs on an HTML canvas and needs a keyboard and mouse. The
    controls are listed below the editor.
  </canvas>

  <div class="console-section">
    <form id="command-form" class="command-form">
      <label for="command-input">Command API</label>
      <div class="command-row">
        <input
          type="text"
          id="command-input"
          class="command-input"
          placeholder="e.g. list"
          autocomplete="off"
          spellcheck="false"
          disabled
        />
        <button type="submit" id="command-submit" class="btn-send" disabled>
          Send
        </button>
      </div>
    </form>
    <output id="command-output" class="command-output" aria-live="polite" for="command-input"></output>
  </div>

  <div class="shortcuts-panel">
    <h2>Keyboard shortcuts</h2>
    <ul class="shortcuts-list">
      <li><kbd>Ctrl+P</kbd> — play / pause; <kbd>F5</kbd> — play; <kbd>Ctrl+Shift+P</kbd> — stop</li>
      <li><kbd>Ctrl+S</kbd> — save the scene to this browser; <kbd>Ctrl+Shift+S</kbd> — save as</li>
      <li><kbd>Q</kbd> / <kbd>W</kbd> / <kbd>E</kbd> / <kbd>R</kbd> — select / move / rotate / scale tool</li>
      <li><kbd>Space</kbd> + drag or middle drag — pan; scroll — zoom; <kbd>+</kbd> / <kbd>−</kbd> / <kbd>0</kbd> — zoom in / out / reset</li>
      <li><kbd>F</kbd> — frame the selection; <kbd>Home</kbd> — reset the camera</li>
      <li>Click — select; <kbd>Shift</kbd> — add; <kbd>Ctrl</kbd> — toggle; <kbd>Ctrl+A</kbd> — all; <kbd>Esc</kbd> — cancel</li>
      <li>Arrows — nudge the selection (<kbd>Shift</kbd> ×10); <kbd>F2</kbd> — rename</li>
      <li><kbd>Ctrl+Z</kbd> / <kbd>Ctrl+Shift+Z</kbd> — undo / redo; <kbd>Ctrl+D</kbd> — duplicate; <kbd>Ctrl+C</kbd> / <kbd>Ctrl+X</kbd> / <kbd>Ctrl+V</kbd> — copy / cut / paste</li>
      <li><kbd>Delete</kbd> or <kbd>Backspace</kbd> — delete the selection</li>
      <li><kbd>G</kbd> — grid; <kbd>S</kbd> — snapping; <kbd>C</kbd> — collider outlines</li>
    </ul>
  </div>
</div>

<script>
  import '../scripts/playground-embed.ts';
</script>

<style>
  .playground-embed {
    background: var(--surface);
    border: 1px solid var(--border-bright);
    border-radius: 10px;
    margin: 1.5rem 0 2rem;
    padding: 1rem;
    box-sizing: border-box;
    max-width: 100%;
  }

  .status {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.85rem;
    color: var(--text-bright);
    text-align: center;
    min-height: 1.2em;
    margin: 0 0 0.6rem;
  }

  .playground-banner {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    text-align: center;
    min-height: 1.2em;
    margin: 0 0 0.6rem;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .field-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
  }

  .field-group label {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-dim);
    flex-shrink: 0;
  }

  .field-group select {
    background: var(--surface-raised);
    color: var(--text-bright);
    border: 1px solid var(--border-bright);
    border-radius: 4px;
    padding: 0.3rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    max-width: 100%;
  }

  .reset-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .btn-reset {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: 0.3rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    cursor: pointer;
  }

  .btn-reset:hover:not(:disabled) {
    background: var(--accent);
    color: var(--bg);
  }

  .btn-reset:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .reset-note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    font-style: italic;
  }

  .archive-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .btn-toolbar {
    background: var(--surface-raised);
    color: var(--text-bright);
    border: 1px solid var(--border-bright);
    border-radius: 4px;
    padding: 0.3rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    cursor: pointer;
  }

  .btn-toolbar:hover:not(:disabled) {
    background: var(--accent);
    color: var(--bg);
  }

  .btn-toolbar:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .label-import {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    display: inline-flex;
    align-items: center;
  }

  .input-file {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-bright);
    max-width: 100%;
  }

  .input-file:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .banner-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .btn-banner-action {
    background: var(--surface-raised);
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: 0.25rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .btn-banner-action:hover {
    background: var(--accent);
    color: var(--bg);
  }

  /* :global — the engine REPLACES the placeholder canvas with winit's own
     element, which lacks Astro’s scoping attribute. */
  .playground-embed :global(canvas) {
    display: block;
    margin: 0 auto;
    max-width: 100%;
    background: #000;
    outline: none;
    border-radius: 4px;
  }

  .console-section {
    margin-top: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .command-form {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .command-form label {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .command-row {
    display: flex;
    gap: 0.5rem;
  }

  .command-input {
    flex: 1;
    min-width: 0;
    box-sizing: border-box;
    background: var(--surface-raised);
    color: var(--text-bright);
    border: 1px solid var(--border-bright);
    border-radius: 4px;
    padding: 0.4rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .command-input:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-send {
    flex-shrink: 0;
    background: var(--accent);
    color: var(--bg);
    border: none;
    border-radius: 4px;
    padding: 0.4rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .btn-send:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .command-output {
    display: block;
    box-sizing: border-box;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.5rem;
    max-height: 150px;
    overflow-y: auto;
    overflow-x: auto;
    word-break: break-word;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .command-echo {
    color: var(--text-bright);
  }

  .response-line {
    color: var(--text-dim);
    white-space: pre-wrap;
  }

  .error-line {
    color: var(--accent);
  }

  .shortcuts-panel {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .shortcuts-panel h2 {
    font-size: 0.95rem;
    margin: 0 0 0.5rem;
    color: var(--text-bright);
  }

  .shortcuts-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  @media (min-width: 48rem) {
    .shortcuts-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .shortcuts-list kbd {
    background: var(--surface-raised);
    border: 1px solid var(--border-bright);
    border-radius: 3px;
    padding: 0.1rem 0.3rem;
    color: var(--text-bright);
  }
</style>
