---
/**
 * The Web Playground's workspace: the boot status, the banner, the canvas
 * stage and the dock beneath it.
 *
 * The bar controls are not here — they belong to the page, which slots
 * PlaygroundToolbar.astro into AppLayout's bar. What stays is what fills the
 * window: a three-row grid whose middle row is the canvas, so the editor
 * grows with the viewport instead of sitting in a reading column.
 *
 * Exactly ONE playground embed per page: the engine binds to fixed DOM IDs
 * and module singletons.
 */
import CompatibilityPanel from './CompatibilityPanel.astro';

interface Props {
  src?: string;
  width?: number;
  height?: number;
  screenshot?: string;
  screenshotAlt?: string;
}

const {
  src = '/playground/v2/game.js',
  width = 1280,
  height = 800,
  screenshot = '/images/platformer-in-editor-2026-08.png',
  screenshotAlt = 'The Insiculous 2D scene editor in a browser, a platformer scene open in it',
} = Astro.props;
---

<div class="playground-embed" data-wasm-src={src}>
  <div class="head-region">
    <div class="banner-region">
      <p id="playground-banner" class="playground-banner" role="alert"></p>
      <div id="import-rejection-actions" class="banner-actions"></div>
      <div id="conflicted-actions" class="banner-actions"></div>
      {/* Static, so a blocked popup shows a live region the browser has already
          announced the existence of rather than one built after the refusal. */}
      <p id="preview-blocked" class="playground-banner" role="alert" hidden>
        Your browser blocked the preview window.
        <button type="button" id="preview-retry" class="btn-banner-action">Try again</button>
        — or press F5 in the editor to play here.
      </p>
    </div>
    <p id="game-loading" class="status" role="status">Checking WebGPU…</p>
    <CompatibilityPanel screenshot={screenshot} screenshotAlt={screenshotAlt} />
  </div>

  <div class="stage">
    <canvas
      id="game-canvas"
      width={width}
      height={height}
      tabindex="0"
      role="img"
      aria-label="Web Playground — scene editor canvas; focus it to edit and play"
    >
      The Web Playground runs on an HTML canvas and needs a keyboard and mouse. The
      controls are in the dock below the editor and in Help.
    </canvas>
  </div>

  <details id="dock" class="dock">
    <summary>Scripts and console</summary>
    {/* The body scrolls at narrow widths, so it is focusable and named — axe's
        scrollable-region-focusable, the same shape /profile/'s achievements box uses. */}
    <div class="dock-body" tabindex="0" role="group" aria-label="Scripts and console">
      <section class="scripts-section" aria-labelledby="scripts-heading">
        <h2 id="scripts-heading">Scripts</h2>
        <div class="scripts-toolbar">
          <label for="script-select" class="scripts-label">Script</label>
          <select id="script-select" class="script-select" disabled>
            <option value="">No scripts</option>
          </select>
          <button type="button" id="script-save" class="btn-script-save" disabled>
            Save
          </button>
          <output id="script-status" class="script-status" aria-live="polite" for="script-source script-save"></output>
        </div>
        <label for="script-source" class="visually-hidden">Script source</label>
        <textarea
          id="script-source"
          class="script-source"
          placeholder="Select a script above…"
          autocomplete="off"
          spellcheck="false"
          disabled
        ></textarea>
        <output id="script-runtime-errors" class="script-runtime-errors" aria-live="polite"></output>
      </section>

      <section class="console-section" aria-labelledby="console-heading">
        <h2 id="console-heading">Command</h2>
        <form id="command-form" class="command-form">
          <label for="command-input">Command API</label>
          <div class="command-row">
            <input
              type="text"
              id="command-input"
              class="command-input"
              placeholder="e.g. list"
              autocomplete="off"
              spellcheck="false"
              disabled
            />
            <button type="submit" id="command-submit" class="btn-send" disabled>
              Send
            </button>
          </div>
        </form>
        <output id="command-output" class="command-output" aria-live="polite" for="command-input"></output>
      </section>
    </div>
  </details>
</div>

<script>
  import '../scripts/playground-embed.ts';
</script>

<style>
  .playground-embed {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    min-width: 0;
    min-height: 0;
    box-sizing: border-box;
  }

  .head-region {
    min-width: 0;
  }

  .status {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.85rem;
    color: var(--text-bright);
    text-align: center;
    min-height: 1.2em;
    margin: 0 0 0.6rem;
  }

  .playground-banner {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    text-align: center;
    min-height: 1.2em;
    margin: 0 0 0.6rem;
  }

  .banner-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .btn-banner-action {
    background: var(--surface-raised);
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: 0.25rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .btn-banner-action:hover {
    background: var(--accent);
    color: var(--bg);
  }

  .stage {
    min-width: 0;
    min-height: 0;
    background: #000;
    border-radius: 4px;
    overflow: hidden;
  }

  /* :global because winit's canvas — which REPLACES the placeholder at boot — carries
     no scoping attribute, and !important because winit writes width and height inline
     once at creation and only !important beats an inline declaration. The canvas box
     is then the stage's grid area, so a window resize, the dock opening or fullscreen
     changes the box and the engine follows it on Resized. */
  .playground-embed :global(canvas) {
    width: 100% !important;
    height: 100% !important;
    max-width: 100%;
    display: block;
    background: #000;
    outline: none;
  }

  .dock {
    margin-top: 0.6rem;
    border-top: 1px solid var(--border);
    min-width: 0;
  }

  .dock > summary {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    cursor: pointer;
    padding: 0.4rem 0;
  }

  /* The dock is a row of the workspace grid, not an overlay: opening it shrinks the
     stage rather than covering the editor's own status bar. */
  .dock-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    max-height: min(40dvh, 22rem);
    overflow: auto;
    min-width: 0;
  }

  @media (min-width: 66rem) {
    .dock-body {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .dock-body h2 {
    font-size: 0.9rem;
    margin: 0;
    color: var(--text-bright);
  }

  .scripts-section,
  .console-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .scripts-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .scripts-label {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .script-select {
    background: var(--surface-raised);
    color: var(--text-bright);
    border: 1px solid var(--border-bright);
    border-radius: 4px;
    padding: 0.3rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    max-width: 100%;
  }

  .script-select:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-script-save {
    background: var(--surface-raised);
    color: var(--text-bright);
    border: 1px solid var(--border-bright);
    border-radius: 4px;
    padding: 0.3rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .btn-script-save:hover:not(:disabled) {
    background: var(--accent);
    color: var(--bg);
  }

  .btn-script-save:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .script-status {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    flex: 1;
    min-width: 0;
    word-break: break-word;
  }

  .script-source {
    width: 100%;
    box-sizing: border-box;
    min-height: 160px;
    background: var(--surface-raised);
    color: var(--text-bright);
    border: 1px solid var(--border-bright);
    border-radius: 4px;
    padding: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.4;
    resize: vertical;
    white-space: pre;
  }

  .script-source:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .script-runtime-errors {
    display: block;
    box-sizing: border-box;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .command-form {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .command-form label {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .command-row {
    display: flex;
    gap: 0.5rem;
  }

  .command-input {
    flex: 1;
    min-width: 0;
    box-sizing: border-box;
    background: var(--surface-raised);
    color: var(--text-bright);
    border: 1px solid var(--border-bright);
    border-radius: 4px;
    padding: 0.4rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .command-input:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-send {
    flex-shrink: 0;
    background: var(--accent);
    color: var(--bg);
    border: none;
    border-radius: 4px;
    padding: 0.4rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .btn-send:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .command-output {
    display: block;
    box-sizing: border-box;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.5rem;
    max-height: 150px;
    overflow-y: auto;
    overflow-x: auto;
    word-break: break-word;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .command-echo {
    color: var(--text-bright);
  }

  .response-line {
    color: var(--text-dim);
    white-space: pre-wrap;
  }

  .error-line {
    color: var(--accent);
  }
</style>
