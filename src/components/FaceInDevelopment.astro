---
// A face page that is not on production yet.
//
// These exist as FILES rather than as deletions on purpose. The real pages belong to the back-burnered
// creation chain, parked at the tag `creation-chain-parked` — it replaced the `fortknightdev` and
// `forknifedev` branches, which were re-ruled playgrounds on 2026-08-28 and deleted on 2026-08-29.
// Recover any of them with `git show creation-chain-parked:PATH`. A placeholder keeps the path occupied
// so the chain returning is an ordinary content merge rather than a modify/delete conflict per route,
// and keeps the URL from 404ing in the meantime.
//
// These no longer go away by a face branch merging — that route was closed by the 2026-08-28 ruling.
// A seed-fed replacement built fresh in the `main` lineage is what retires each placeholder.
import FaceLayout from "../layouts/FaceLayout.astro";
import { facePath } from "../lib/faces.js";

const { title, face } = Astro.props;
const home = facePath(face);
---
<FaceLayout title={title} face={face}>
  <section class="panel">
    <h1>{title}</h1>
    <p>
      This page is still being built. It works in development and is not on the live site yet —
      what is here now is the part that is finished.
    </p>
    <p class="muted">
      Anything you saved on this device is kept, and comes back when this page does.
    </p>
    <p><a href={home}>Back to the overview</a></p>
  </section>
</FaceLayout>
