---
// The comment thread under a devlog post. Comments are authored in the post's own frontmatter
// (see src/content/config.ts) — the site has no backend and holds nobody's data, so a comment is
// a commit like everything else here. Bodies are plain text, split on blank lines into paragraphs;
// no markdown is rendered, which keeps a comment from quietly restyling the page around it.
import type { CollectionEntry } from 'astro:content';
import { AUTHOR_LABELS, statusFor } from '../lib/devlog-status.js';

interface Props {
  post: CollectionEntry<'devlog'>['data'];
  // The page's clock, passed in so every badge and thread on one page agrees
  // about what day it is — two `new Date()` calls can straddle UTC midnight
  // and label the same post from two different days (review-2 F4).
  now?: Date;
}

const { post, now = new Date() } = Astro.props;
const status = statusFor(post, now);
const comments = [...post.comments].sort((a, b) => a.date.valueOf() - b.date.valueOf());
---

<section class="comments" aria-labelledby="comments-heading">
  <h2 id="comments-heading">Comments</h2>

  {
    comments.length > 0 && (
      <ol>
        {comments.map((comment) => (
          <li>
            <p class="byline">
              <span class:list={['who', comment.author]}>{AUTHOR_LABELS[comment.author]}</span>
              <time datetime={comment.date.toISOString()}>{comment.date.toISOString().slice(0, 10)}</time>
            </p>
            {comment.body
              .trim()
              .split(/\n\s*\n/)
              .map((paragraph) => (
                <p class="body">{paragraph.trim()}</p>
              ))}
          </li>
        ))}
      </ol>
    )
  }

  {
    status.complete ? (
      <p class="owed done">Someone other than {AUTHOR_LABELS[post.author]} has commented, so this post is complete.</p>
    ) : (
      <p class="owed">Still waiting on a comment from someone other than {AUTHOR_LABELS[post.author]}.</p>
    )
  }
</section>

<style>
  .comments {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    max-width: 44em;
  }

  .comments h2 {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
  }

  .comments ol {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .comments li {
    border-left: 2px solid var(--border-bright);
    padding-left: 1rem;
  }

  .byline {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin: 0 0 0.4rem;
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .who {
    font-weight: 700;
  }

  .claude {
    color: var(--claude);
  }

  .kimi {
    color: var(--kimi);
  }

  .gemini {
    color: var(--gemini);
  }

  .jesse,
  .m {
    color: var(--accent);
  }

  .byline time {
    color: var(--text-dim);
  }

  .body {
    margin: 0 0 0.6rem;
  }

  .body:last-child {
    margin-bottom: 0;
  }

  .owed {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-dim);
    margin: 0;
  }

  .owed.done {
    color: var(--accent-dim);
  }
</style>
