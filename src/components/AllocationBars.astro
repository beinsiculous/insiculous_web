---
import { categoryLabel } from "../lib/labels.js";

const { allocations } = Astro.props;
const views = [
  ["byBlockFocus", "Focus grid"],
  ["byActivities", "Activities"],
];
---
{views.map(([viewKey, viewLabel]) => (
  <>
    <div class="allocation-legend">{viewLabel} — {allocations[viewKey].method}</div>
    {Object.entries(allocations[viewKey].shareByCategory).map(([categoryKey, share]) => (
      <div class={`allocation-row${share === 0 ? " zero" : ""}`}>
        <span>{categoryLabel(categoryKey)}</span>
        <div class="allocation-bar">
          <span
            class={`fill${categoryKey === "flexible" ? " flexible" : ""}`}
            style={categoryKey === "flexible"
              ? `width: ${Math.round(share * 100)}%`
              : `width: ${Math.round(share * 100)}%; background: var(--${categoryKey})`}
          ></span>
          <span class="allocation-value">{(share * 100).toFixed(1)}%</span>
        </div>
      </div>
    ))}
  </>
))}
