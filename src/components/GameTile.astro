---
/**
 * One tile of the /games/ shelf: the game's name plate over its capsule art, the whole tile one link
 * to the game's play page. One link, because a second link inside the tile would split the accessible
 * name and the tap target — so the "edit on the playground" button lives on the play page instead.
 *
 * The name is an image because it is shown in its title screen's lettering, and that lettering is
 * drawn pixel art, not a font: a logotype is the one case WCAG 1.4.5 allows an image of text. The
 * trade is that the plate does not grow with the visitor's text size. The plate's alt is the name: it
 * is the link's one accessible name, announced once, and when the plate fails to load or images are
 * off, the browser renders that alt as the visible name in the plate's place. The art's alt is empty.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  game: CollectionEntry<'games'>;
}

const { game } = Astro.props;
---

<li class="tile">
  <a href={`/games/${game.id}/`}>
    <img class="plate" src={game.data.namePlate} alt={game.data.title} width="256" height="64" decoding="async" />
    <img class="art" src={game.data.capsule} alt="" width="256" height="256" decoding="async" />
  </a>
</li>

<style>
  a {
    display: block;
  }

  /* Both images are drawn at their own size, so a 2× screen doubles each pixel; smoothing would blur them. */
  img {
    display: block;
    image-rendering: pixelated;
  }

  .plate {
    width: 256px;
    height: 64px;
    margin-bottom: 0.5rem;
  }

  .art {
    width: 256px;
    height: 256px;
  }

  /* global.css's ring is 2 px; the tile's is 3 px on the whole box, inside the shelf's gutter. */
  a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
</style>
