---
// One day of the Overview's menu grid: the day label and one line per meal (filled on the client from
// the active profile's menu via menuForDay; the prerendered card is the no-JS fallback and links to the day page,
// which shows the same menu line).
import { facePath } from "../lib/faces.js";

const { dayKey, day } = Astro.props;
---
<a class="day-card menu-day-card" href={facePath("fortknight", `days/${dayKey}/`)} data-day-key={dayKey} data-weekday={day.weekday}>
  <div class="day-label"><span>{day.label}</span></div>
  <ul class="menu-lines"><li class="muted">—</li></ul>
</a>
