---
// One questionnaire question (data/questionnaire.json): the wrapper (intro, numbered prompt, note) and the field for
// the simple kinds — number, multi-select, single-select, text — and the meals editor. Any other kind renders the
// page's own markup passed as the slot (FortKnight's sliders, commitments, year split, waking window …).
// The reader / populator for what this renders is src/lib/question-fields.js.
const { question, index, options, questionnaire } = Astro.props;
const SIMPLE_KINDS = ["number", "multi-select", "single-select", "text", "meals"];
const mealIndexes = Array.from({ length: questionnaire.mealsPerDay.max }, (_, mealIndex) => mealIndex);
const mealCounts = Array.from({ length: questionnaire.mealsPerDay.max - questionnaire.mealsPerDay.min + 1 }, (_, offset) => questionnaire.mealsPerDay.min + offset);
---
<div class="question" data-question={question.id} data-kind={question.kind}>
  {question.intro && <p class="question-intro">{question.intro}</p>}
  <h2>{index + 1}. {question.prompt}</h2>
  {question.note && <p class="muted">{question.note}</p>}

  {question.kind === "number" && (
    <label class="inline-field">Answer <input type="number" name={question.id} min={question.min ?? 0} value={question.default ?? 1} /></label>
  )}

  {question.kind === "multi-select" && (
    <ul class="pick-list">
      {options[question.options].map((option) => (
        <li><label><input type="checkbox" name={question.id} value={option.id} /> {option.label}</label></li>
      ))}
    </ul>
  )}

  {question.kind === "single-select" && (
    <ul class="pick-list pick-list-inline">
      {options[question.options].map((option) => (
        <li><label><input type="radio" name={question.id} value={option.id} /> {option.label}</label></li>
      ))}
    </ul>
  )}

  {question.kind === "text" && (
    <textarea name={question.id} rows="4" placeholder={question.placeholder ?? ""} aria-label={question.prompt}></textarea>
  )}

  {question.kind === "meals" && (
    <div class="meals-editor">
      <label class="inline-field">Meals per day
        <select name="mealsPerDay">
          {mealCounts.map((count) => (
            <option value={count}>{count}</option>
          ))}
        </select>
      </label>
      <table class="category-table meals-table">
        <thead><tr><th scope="col">Meal</th><th scope="col">Eaten ({questionnaire.slotsPerMeal.min}–{questionnaire.slotsPerMeal.max} times of day)</th><th scope="col">Needs prepping</th><th scope="col">Needs cooking</th></tr></thead>
        <tbody>
          {mealIndexes.map((mealIndex) => (
            <tr class="meal-row" data-meal-index={mealIndex}>
              <th scope="row"><input type="text" class="meal-name" name={`mealName-${mealIndex}`} placeholder={`Meal ${mealIndex + 1}`} aria-label={`meal ${mealIndex + 1} name`} autocomplete="off" /></th>
              <td class="meal-slots-cell">
                {options.mealSlots.map((slot) => (
                  <label><input type="checkbox" name={`mealSlots-${mealIndex}`} value={slot.id} aria-label={`meal ${mealIndex + 1}: ${slot.label}`} /> {slot.label}</label>
                ))}
              </td>
              <td class="meal-prep-cell">
                <label><input type="checkbox" name={`mealPrepped-${mealIndex}`} aria-label={`meal ${mealIndex + 1} needs prepping`} /> <span class="muted">prep</span></label>
                <label class="meal-minutes"><input type="range" name={`mealPrepMinutes-${mealIndex}`} min={questionnaire.mealPrep.minutes.min} max={questionnaire.mealPrep.minutes.max} step={questionnaire.mealPrep.minutes.step} value={questionnaire.mealPrep.defaultPrepMinutes} aria-label={`meal ${mealIndex + 1} prep minutes`} /><output>{questionnaire.mealPrep.defaultPrepMinutes} min</output></label>
              </td>
              <td class="meal-prep-cell">
                <label><input type="checkbox" name={`mealCooked-${mealIndex}`} aria-label={`meal ${mealIndex + 1} needs cooking`} /> <span class="muted">cook</span></label>
                <label class="meal-minutes"><input type="range" name={`mealCookMinutes-${mealIndex}`} min={questionnaire.mealPrep.minutes.min} max={questionnaire.mealPrep.minutes.max} step={questionnaire.mealPrep.minutes.step} value={questionnaire.mealPrep.defaultCookMinutes} aria-label={`meal ${mealIndex + 1} cook minutes`} /><output>{questionnaire.mealPrep.defaultCookMinutes} min</output></label>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {!SIMPLE_KINDS.includes(question.kind) && <slot />}
</div>
