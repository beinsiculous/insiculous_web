---
import FaceLayout from "../../layouts/FaceLayout.astro";
import MealPlanEditor from "../../components/MealPlanEditor.astro";
import { withBase } from "../../lib/paths.js";
import { PROFILE_PATH, facePath } from "../../lib/faces.js";

// Spoon Feed: ForkKnife's page for building the fortnight menu by hand (docs/meal-plan.md) — for each meal the dishes
// and the day(s) they are eaten, the second day being leftovers. The meals it is keyed by (names, times of day, prep
// and cooking) are answered on the Questionnaire; a whole menu can also arrive as a meal-plan document on the
// Assistant page. Save writes only the menu over the active profile as stored at that moment, so a save here never
// touches the answers another page owns.
---
<FaceLayout title="Spoon Feed" face="forkknife">
  <section class="panel">
    <h1>Spoon Feed</h1>
    <p class="muted">Feed the menu one dish at a time. It is kept with the rest of your profile on this device; the <a href={facePath("forkknife")}>Overview</a> shows it as the fortnight grid and turns it into your meal-prep and cooking tasks, and the <a href={withBase(PROFILE_PATH)}>Profile page</a> turns the whole profile into files for your own AI workspace.</p>
    <p class="profile-bar" id="profileBar"><strong id="profileName"></strong> <span class="muted" id="profileStatus"></span></p>
    <form id="spoonFeedForm" class="settings-form">
      <MealPlanEditor face="forkknife" />
      <div class="button-row">
        <button type="submit">Save</button>
      </div>
      <p class="muted" id="spoonFeedStatus"></p>
    </form>
    <noscript><p class="muted">This page needs JavaScript to edit your menu.</p></noscript>
  </section>
</FaceLayout>

<script>
  import { loadSettings, profileIds, saveSettings, setActiveWeights } from "../../lib/shared/user-settings.js";
  import { activeWeights, answersProblem, defaultAnswers, pickAnswers, userWeightsFromAnswers } from "../../lib/shared/weights-rules.js";
  import { localTodayIsoDate } from "../../lib/shared/clock.js";
  import { loadMealPlan } from "../../lib/forkknife.js";
  import { mountMealPlanEditor } from "../../lib/meal-plan-editor.js";
  import { MENU_ANSWER_KEYS } from "../../lib/answer-keys.js";
  import { promptProfileName } from "../../lib/profile-naming.js";
  import { withBase } from "../../lib/paths.js";

  const form = document.getElementById("spoonFeedForm");
  const status = document.getElementById("spoonFeedStatus");
  const planStatus = document.getElementById("planStatus");
  let bundle = null;
  let settings = loadSettings();
  let editor = null;
  let dirty = false;

  /** The profile line: the active profile's name and whether it is saved (switching lives in the nav dropdown). */
  function renderProfileBar() {
    const saved = Boolean(settings.weightsProfiles[settings.activeWeightsId]);
    document.getElementById("profileName").textContent = `Profile ${settings.activeWeightsId}`;
    document.getElementById("profileStatus").textContent = saved ? `— saved (${profileIds(settings).length} on this device)` : "— not saved yet";
  }

  function markDirty() {
    dirty = true;
    status.textContent = "Unsaved changes.";
  }

  /** The active profile's meals and menu into the editor. */
  function populateFromSettings() {
    settings = loadSettings();
    renderProfileBar();
    const plan = loadMealPlan(bundle, settings);
    editor.setMeals(plan.meals);
    editor.setItems(plan.items);
    editor.render();
    planStatus.textContent = plan.problems.length
      ? `${plan.problems.length === 1 ? "1 stored dish no longer matches your meals and was dropped" : `${plan.problems.length} stored dishes no longer match your meals and were dropped`}: ${plan.problems.join("; ")}.`
      : "";
    dirty = false;
    status.textContent = plan.saved
      ? `Loaded the menu of profile ${settings.activeWeightsId}: ${plan.items.length} dish${plan.items.length === 1 ? "" : "es"} across ${plan.meals.length} meal${plan.meals.length === 1 ? "" : "s"}.`
      : `Profile ${settings.activeWeightsId} is new — add dishes and Save to keep it.`;
  }

  /** The whole answers object at save time: the profile as stored *right now* (another tab, or the Questionnaire,
   *  may have saved meanwhile) with only this page's key — the menu — written over it. */
  async function save() {
    const stored = loadSettings();
    stored.activeWeightsId = settings.activeWeightsId; // the profile shown on this page, not whichever another tab switched to
    const base = activeWeights(stored)?.questionnaire?.answers ?? defaultAnswers(bundle.questionnaire, bundle.categories);
    const answers = { ...base, ...pickAnswers({ mealPlan: { items: editor.getItems() } }, MENU_ANSWER_KEYS) };
    const problem = answersProblem(answers, bundle.questionnaire, bundle.categories);
    if (problem) { status.textContent = problem; return; }
    const firstSave = !activeWeights(stored);
    try {
      setActiveWeights(stored, userWeightsFromAnswers(answers, bundle, { weightsId: stored.activeWeightsId, epochOverride: stored.epochOverride, answeredAt: localTodayIsoDate() }));
      saveSettings(stored);
    } catch (error) {
      status.textContent = `Not saved: ${error.message}`;
      return;
    }
    settings = stored;
    dirty = false;
    const note = firstSave ? await promptProfileName(settings.activeWeightsId) : "";
    settings = loadSettings();
    document.dispatchEvent(new CustomEvent("fortknight:settings-saved"));
    renderProfileBar();
    status.textContent = `Saved the menu of profile ${settings.activeWeightsId} on this device.${note}`;
  }

  // Switching profiles from the nav dropdown reloads the page: with unsaved edits, ask first (cancel vetoes the switch).
  document.addEventListener("fortknight:profile-switch", (event) => {
    if (!dirty) return;
    if (confirm("You have unsaved changes in this profile — switch anyway and drop them?")) dirty = false;
    else event.preventDefault();
  });
  window.addEventListener("beforeunload", (event) => { if (dirty) event.preventDefault(); });

  if (form) {
    form.addEventListener("submit", (event) => { event.preventDefault(); if (bundle) save(); });
    try {
      const response = await fetch(withBase("bundle.json"));
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      bundle = await response.json();
      editor = mountMealPlanEditor(document.getElementById("mealSections"), {
        dayOptions: bundle.days.order.map((dayKey) => ({ dayKey, label: bundle.days.days[dayKey].label })),
        onChange: markDirty,
      });
      populateFromSettings();
    } catch (error) {
      status.textContent = "Could not load the app's data — run python3 scripts/build.py, then restart the app (npm run dev).";
      console.error(error);
    }
  }
</script>
