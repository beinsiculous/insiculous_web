---
// The every-achievement board moved into the Profile page's Achievements panel — keep the URL
// working. The page was a studio nav entry, so bookmarks and outside links name it.
import { withBase } from "../lib/paths.js";
const target = `${withBase("profile/")}#achievements`;
---
<html lang="en"><head><meta charset="utf-8" /><meta http-equiv="refresh" content={`0; url=${target}`} /><title>Moved to Profile</title></head><body><h1>Moved to Profile</h1><p>Achievements moved to your <a href={target}>Profile</a>.</p></body></html>
