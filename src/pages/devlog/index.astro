---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SupportLink from '../../components/SupportLink.astro';
import DevlogStatus from '../../components/DevlogStatus.astro';
import { AUTHOR_LABELS, postsStillNew } from '../../lib/devlog-status.js';
import { publishedPosts } from '../../lib/devlog-posts.js';
import { KOFI_URL, KOFI_LABEL, KOFI_TITLE } from '../../lib/site-links.js';

// One clock for every badge on the page (review-2 F4).
const now = new Date();
const posts = publishedPosts(await getCollection('devlog'), now);

// A build can only see the state, never the act of publishing — so this reports the state and
// leaves the consequence conditional (review-1 F2). Warn rather than fail: publishing onto a
// devlog that has not gone quiet is a judgement call, not a bug.
const crowded = postsStillNew(posts.map((post) => post.data), now);
if (crowded.length > 1) {
  console.warn(
    `\ndevlog: not quiet — ${crowded.length} posts still read NEW: ` +
      crowded.map((post) => `“${post.title}”`).join(', ') +
      '. Anything published now takes the listing from them before they have been commented on; ' +
      'hold it with `draft: true` until this clears.'
  );
}
---

<BaseLayout
  title="Devlog — Be Insiculous"
  description="Development notes on games and the Insiculous 2D engine."
>
  <p class="section-label">devlog</p>
  <div class="title-row">
    <h1>Devlog</h1>
    <a
      class="coffee-link"
      href={KOFI_URL}
      title={KOFI_TITLE}
      aria-label={KOFI_LABEL}
      target="_blank"
      rel="noopener noreferrer">☕</a>
  </div>
  <p class="intro">
    Notes from the trenches — engine internals, game progress, and the
    occasional coding-agent war story. <a href="/rss.xml">RSS</a>
  </p>

  <ul class="posts">
    {
      posts.map((post) => (
        <li>
          <span class="date">{post.data.pubDate.toISOString().slice(0, 10)}</span>
          <div>
            <p class="title-line">
              <a class="title" href={`/devlog/${post.id}/`}>
                {post.data.title}
              </a>
              <DevlogStatus post={post.data} now={now} />
            </p>
            <p>{post.data.description}</p>
            <p class="byline">
              by {AUTHOR_LABELS[post.data.author]} ·{' '}
              {post.data.comments.length === 1 ? '1 comment' : `${post.data.comments.length} comments`}
            </p>
          </div>
        </li>
      ))
    }
  </ul>

  <SupportLink blurb="These notes are free and always will be. If they have been useful, there is a tip jar." />
</BaseLayout>

<style>
  /* The ☕ sits beside the heading, not inside it: an emoji inside <h1> would be folded into the
     heading’s accessible name and read out as part of "Devlog" in a heading list. Wrapping keeps
     125% text at 390px from pushing the page sideways. */
  .title-row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .title-row h1 {
    margin-bottom: 0;
  }

  /* global.css sets no emoji stack the way faces.css does for .face-link. */
  .coffee-link {
    font-size: 1.35rem;
    line-height: 1;
    text-decoration: none;
    opacity: 0.8;
    font-family: 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
  }

  .coffee-link:hover {
    opacity: 1;
    text-decoration: none;
  }

  .intro {
    max-width: 42em;
    margin-bottom: 2.5rem;
  }

  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .posts li {
    display: flex;
    gap: 1.5rem;
    align-items: baseline;
  }

  .date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-dim);
    white-space: nowrap;
  }

  /* The badge sits beside the link, not inside it: it must not be folded into the link's
     accessible name, and at 125% text it needs to be free to wrap onto its own line. */
  .title-line {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .title {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: var(--text-bright);
  }

  .byline {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .title:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .posts p {
    margin: 0.25rem 0 0;
    font-size: 0.95rem;
    color: var(--text);
  }

  @media (max-width: 40rem) {
    .posts li {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
