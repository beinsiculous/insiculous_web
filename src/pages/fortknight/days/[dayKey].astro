---
import FaceLayout from "../../../layouts/FaceLayout.astro";
import bundle from "../../../../build/fortknight.bundle.json";
import { DAY_KEY_ORDER } from "../../../lib/shared/fortknight-rules.js";
import { withBase } from "../../../lib/paths.js";
import { facePath } from "../../../lib/faces.js";

// One day of the person's fortnight, rendered on the client from their active profile (their blocks and
// the focus their grid gives each block (own or imported), imported fixed activities, standing appointments, imported menu entries — src/lib/shared/day-plan.js).
// The server renders only the shell: the bundle's data set carries nobody's schedule (docs/app.md).
export function getStaticPaths() {
  return DAY_KEY_ORDER.map((dayKey) => ({ params: { dayKey } }));
}

const { dayKey } = Astro.params;
const day = bundle.days.days[dayKey];
---
<FaceLayout title={day.label} face="fortknight">
  <section class="panel">
    <p class="back-link"><a href={facePath("fortknight")}>← Overview</a></p>
    <h1 id="dayTitle">{day.label}</h1>
    <p class="muted" id="dayMeta">Week {day.week} · {day.weekday}</p>
    <p class="muted" id="proposedControls" hidden>
      <label><input type="checkbox" id="showProposed" checked /> Show proposed activities</label>
      <span id="proposedNote"></span>
    </p>
    <div id="dayBody" data-day-key={dayKey}>
      <noscript><p class="muted">This page needs JavaScript to show your day.</p></noscript>
    </div>
  </section>
</FaceLayout>

<script>
  import { parseIsoDate, resolveDate } from "../../../lib/shared/fortknight-rules.js";
  import { loadSettings } from "../../../lib/shared/user-settings.js";
  import { activeWeights, defaultAnswers, formatClockRange, formatClockTime, personCalendarFromSettings, personDayKeyResolver, userWeightsFromAnswers } from "../../../lib/shared/weights-rules.js";
  import { dayPlan } from "../../../lib/shared/day-plan.js";
  import { generateActivities } from "../../../lib/shared/generator-rules.js";
  import { describeDuration } from "../../../lib/shared/clock.js";
  import { withBase } from "../../../lib/paths.js";
  import { facePath } from "../../../lib/faces.js";

  const body = document.getElementById("dayBody");
  const proposedControls = document.getElementById("proposedControls");
  const showProposed = document.getElementById("showProposed");
  const proposedNote = document.getElementById("proposedNote");
  const SHOW_PROPOSED_KEY = "fortknight.showProposedActivities";
  showProposed.checked = sessionStorage.getItem(SHOW_PROPOSED_KEY) !== "no";
  const dayKey = body.dataset.dayKey;
  const settings = loadSettings();
  const date = new URLSearchParams(window.location.search).get("date");
  const title = document.getElementById("dayTitle");
  let bundle = null;
  try {
    const response = await fetch(withBase("bundle.json"));
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    bundle = await response.json();
  } catch (error) {
    body.textContent = "Could not load the app's data — run python3 scripts/build.py, then restart the app (npm run dev).";
    console.error(error);
  }

  function element(tagName, className, text) {
    const node = document.createElement(tagName);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function categoryLabel(categoryKey) {
    if (categoryKey === "flexible") return "Flexible";
    return bundle.categories.categories[categoryKey]?.label ?? categoryKey;
  }

  /** The active profile's weights: saved (when they carry a grid, i.e. saved by this version), else derived from its answers or the defaults. */
  function currentWeightsAndAnswers() {
    const saved = activeWeights(settings);
    const answers = saved?.questionnaire?.answers ?? defaultAnswers(bundle.questionnaire, bundle.categories);
    const epochOverride = settings.epochOverride?.date ? settings.epochOverride : null;
    const weights = saved?.blockFocusGrid && saved?.proposal?.activities ? saved : userWeightsFromAnswers(answers, bundle, { weightsId: settings.activeWeightsId, epochOverride });
    return { weights, answers, resolveDayKey: personDayKeyResolver(answers, bundle, epochOverride) };
  }

  function activityLine(activity) {
    const timing = activity.start ? ` (${activity.end ? formatClockRange(activity.start, activity.end) : formatClockTime(activity.start)})` : activity.timeOfDay ? ` (${activity.timeOfDay})` : activity.minutes ? ` (${describeDuration(activity.minutes)})` : "";
    const priority = activity.priority != null ? `P${activity.priority} ` : "";
    const detail = activity.detail ? ` — ${activity.detail}` : "";
    const source = activity.source === "standing-appointment" ? " · standing appointment" : activity.source === "task" ? " · task" : activity.source === "proposed" ? " · proposed" : "";
    return `${priority}${activity.title}${timing}${detail}${source}`;
  }

  /** The generator's activities for this profile: for the person's own grid when it has cells, else for the proposed
   *  grid (docs/generator.md). Returns { activities, forOwnGrid, warnings }. */
  function proposedActivitiesFor(weights) {
    const ownGridHasCells = Object.values(weights.blockFocusGrid || {}).some((cells) => Object.keys(cells).length);
    const grid = ownGridHasCells ? weights.blockFocusGrid : weights.proposal?.blockFocusGrid || {};
    const generated = generateActivities(weights, grid, bundle.questionnaire, { categories: bundle.categories });
    return { activities: generated.activities, forOwnGrid: ownGridHasCells, warnings: generated.warnings };
  }

  function render() {
    const { weights, answers, resolveDayKey } = currentWeightsAndAnswers();
    const proposed = proposedActivitiesFor(weights);
    proposedControls.hidden = proposed.activities.length === 0;
    proposedNote.textContent = proposed.forOwnGrid ? " (for your grid)" : " (adopt the proposed grid on the Overview to make it yours)";
    const plan = dayPlan({ weights, answers, dayKey, days: bundle.days, resolveDayKey, proposedActivities: showProposed.checked ? proposed.activities : [] });
    body.replaceChildren();
    if (!plan.hasImport && !plan.blocks.some((block) => block.activities.some((activity) => activity.source !== "proposed"))) {
      const note = element("p", "muted");
      note.append("Nothing on this day yet. Add commitments and tasks in the Questionnaire, or apply an import on the ");
      const link = element("a", null, "Assistant page");
      link.href = facePath("fortknight", "assistant/");
      note.append(link, ".");
      body.appendChild(note);
    }
    if (plan.menu.length) {
      body.appendChild(element("p", "menu-line", plan.menu.map((entry) => `${entry.meal}: ${entry.dish ? `${entry.dish}${entry.leftovers ? " (leftovers)" : ""}` : "—"}`).join(" · ")));
    }
    if (plan.meals.length) {
      body.appendChild(element("p", "menu-line", plan.meals.map((meal) => `${meal.slot ? `${meal.slot[0].toUpperCase()}${meal.slot.slice(1)}: ` : ""}${meal.menu}`).join(" · ")));
    }
    for (const block of plan.blocks) {
      const blockElement = element("div", "day-detail-block");
      blockElement.style.borderLeftColor = block.focus ? `var(--${block.focus})` : "var(--line)";
      const heading = element("h3", null, `${block.key[0].toUpperCase()}${block.key.slice(1)} ${formatClockRange(block.start, block.end)}${block.focus ? ` · ${categoryLabel(block.focus)}` : block.carriesFocus ? " · —" : ""}`);
      if (block.isAppointmentBlock) heading.appendChild(element("span", "appointment-tag", "appointments"));
      blockElement.appendChild(heading);
      if (block.activities.length) {
        const list = element("ul");
        for (const activity of block.activities) list.appendChild(element("li", null, activityLine(activity)));
        blockElement.appendChild(list);
      }
      body.appendChild(blockElement);
    }
    if (plan.unplaced.length) {
      const blockElement = element("div", "day-detail-block");
      blockElement.appendChild(element("h3", null, "Outside your blocks"));
      const list = element("ul");
      for (const activity of plan.unplaced) list.appendChild(element("li", null, activityLine(activity)));
      blockElement.appendChild(list);
      body.appendChild(blockElement);
    }
  }

  showProposed.addEventListener("change", () => {
    sessionStorage.setItem(SHOW_PROPOSED_KEY, showProposed.checked ? "yes" : "no");
    render();
  });

  if (bundle) {
    try {
      render();
    } catch (error) {
      body.textContent = `Could not render this day from your settings: ${error.message}`;
      console.error(error);
    }
    // Arriving from the date resolver carries ?date=YYYY-MM-DD; show it — and which season it falls in,
    // by the person's own seasons when settings are saved — in the title.
    if (date) {
      title.textContent += ` — ${date}`;
      try {
        const resolution = resolveDate(bundle, parseIsoDate(date), settings.epochOverride?.date ? settings.epochOverride : null, personCalendarFromSettings(settings, bundle).seasons);
        title.textContent += ` (${resolution.season.name}, ${resolution.seasonSource === "person" ? "your seasons" : "FortKnight seasons"})`;
      } catch { /* the title without a season is fine */ }
    }
  }
</script>
