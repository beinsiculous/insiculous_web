---
import FaceLayout from "../../layouts/FaceLayout.astro";
import ApplyFromAssistant from "../../components/ApplyFromAssistant.astro";
import { withBase } from "../../lib/paths.js";
import { PROFILE_PATH } from "../../lib/faces.js";
---
<FaceLayout title="Apply from assistant" face="fortknight">
  <section class="panel">
    <h1>Apply from assistant</h1>
    <p class="muted">FortKnight has no AI of its own. The files for <em>your</em> AI workspace are downloaded on the <a href={withBase(PROFILE_PATH)}>Profile page</a> (once a profile is saved). Two steps here: get a FortKnight document from your assistant, then paste it. Everything is applied on this device only.</p>

    <div class="apply-step">
      <h3><span class="step-number">1</span> Get the JSON from your assistant</h3>
      <p class="muted">Have your schedule in a spreadsheet — a timetable, a chore rota, a bill calendar, an <code>.xlsx</code> or Sheets export? Download the guide below, upload it <em>and</em> your spreadsheet into your AI workspace, and send this prompt: <button type="button" class="link-button" id="copyPromptButton">Copy the prompt</button></p>
      <p class="prompt-text" id="spreadsheetPrompt"></p>
      <div class="file-list" id="spreadsheetGuideRow"></div>
      <p class="muted">Anything else — a calendar export, a planner photo, "more family time" — ask in the workspace you built from the Profile page's files. The assistant answers with an import file, a weights file, or a settings file — the files tell it how.</p>
    </div>

    <ApplyFromAssistant face="fortknight" />
  </section>
</FaceLayout>

<script>
  import { buildWorkspaceDocuments, SPREADSHEET_GUIDE_FILE_NAME, SPREADSHEET_PROMPT } from "../../lib/shared/workspace-docs.js";
  import { loadSettings } from "../../lib/shared/user-settings.js";
  import { copyText } from "../../lib/shared/download.js";
  import { localTodayIsoDate } from "../../lib/shared/clock.js";
  import { renderFileRow } from "../../lib/shared/workspace-files.js";
  import { missingStaticTexts, staticTexts } from "../../lib/workspace-static-texts.js";
  import { withBase } from "../../lib/paths.js";

  const guideRow = document.getElementById("spreadsheetGuideRow");
  const promptText = document.getElementById("spreadsheetPrompt");
  const copyPromptButton = document.getElementById("copyPromptButton");

  promptText.textContent = SPREADSHEET_PROMPT;
  copyPromptButton.addEventListener("click", async () => {
    try {
      await copyText(SPREADSHEET_PROMPT);
      copyPromptButton.textContent = "Copied";
      setTimeout(() => { copyPromptButton.textContent = "Copy the prompt"; }, 1500);
    } catch (error) {
      alert(`Copy failed: ${error.message}`);
    }
  });

  /** The spreadsheet guide row of step 1 (the whole file set is downloaded on the Profile page). */
  try {
    const response = await fetch(withBase("bundle.json"));
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    const bundle = await response.json();
    const documents = buildWorkspaceDocuments({ bundle, settings: loadSettings(), staticTexts, todayIsoDate: localTodayIsoDate() });
    const guide = documents.find((entry) => entry.fileName === SPREADSHEET_GUIDE_FILE_NAME);
    guideRow.replaceChildren(...(guide ? [renderFileRow(guide)] : []));
    if (missingStaticTexts.includes(SPREADSHEET_GUIDE_FILE_NAME)) guideRow.appendChild(Object.assign(document.createElement("p"), { className: "muted", textContent: `Warning: ${SPREADSHEET_GUIDE_FILE_NAME} did not sync — run npm run dev again.` }));
  } catch (error) {
    console.error(error);
  }
</script>
