---
import FaceLayout from "../../layouts/FaceLayout.astro";
import MealPlanEditor from "../../components/MealPlanEditor.astro";
import bundle from "../../../build/fortknight.bundle.json";
import { withBase } from "../../lib/paths.js";
import { PROFILE_PATH, facePath } from "../../lib/faces.js";

// Build: FortKnight's page for putting things into a profile by hand — the fortnight menu (the same editor as
// ForkKnife's Spoon Feed page, docs/meal-plan.md), the commitments that anchor the day's blocks, and the tasks that
// land on the day pages. All three used to live inside a questionnaire; the questionnaires are settings, this is
// content. The other way in is an import document applied on the Assistant page (docs/importers.md) — it writes the
// same three keys. Save writes only those keys over the active profile as stored at that moment.
const questionnaire = bundle.questionnaire;
const categories = bundle.categories;
const categoryRows = categories.order.map((categoryKey) => ({ key: categoryKey, label: categories.categories[categoryKey].label }));
const options = questionnaire?.options ?? {};
---
<FaceLayout title="Build" face="fortknight">
  <section class="panel">
    <h1>Build</h1>
    <p class="muted">Add what your fortnight is made of, one at a time. Commitments are timed — appointments, lessons, work or school hours — and become the anchors your day’s blocks are cut around. Tasks have a day but no clock time, like chores and errands, and show on your day pages. The menu is the dishes each meal takes on each day. Had your assistant read your calendar, planner or spreadsheet instead? <a href={facePath("fortknight", "assistant/")}>Upload its import file on the Assistant page →</a></p>
    <p class="profile-bar" id="profileBar"><strong id="profileName"></strong> <span class="muted" id="profileStatus"></span></p>
    {questionnaire ? (
    <form id="buildForm" class="settings-form">
      <fieldset class="commitments">
        <legend>Commitments and tasks</legend>
        <div class="appointments-editor">
          <h3 class="editor-heading">Commitments <span class="muted">— timed; they anchor your blocks</span></h3>
          <table class="appointments-table">
            <thead><tr><th scope="col">What</th><th scope="col">Weekdays</th><th scope="col">How often</th><th scope="col">Starts</th><th scope="col">Minutes</th><th scope="col">Category</th><th scope="col"></th></tr></thead>
            <tbody id="appointmentEntry"></tbody>
            <tbody id="appointmentPrototype" hidden>
              <tr class="appointment-row">
              <td><input type="text" data-field="title" placeholder="e.g. Piano lesson" aria-label="commitment title" /></td>
              <td class="weekday-strip">{options.weekdays.map((weekday) => (
                <label title={weekday.label}><input type="checkbox" data-field="weekday" value={weekday.id} /> {weekday.label.slice(0, 2)}</label>
              ))}</td>
              <td>
                <select data-field="cadenceKind" aria-label="how often it repeats">{options.appointmentCadences.map((cadence) => <option value={cadence.id} data-needs={cadence.needs}>{cadence.label}</option>)}</select>
                <input type="date" data-field="firstDate" data-needs="firstDate" aria-label="first date it happens" hidden />
                <select data-field="nth" data-needs="nth" aria-label="which weekday of the month" hidden>{options.nthChoices.map((choice) => <option value={choice.id}>{choice.label}</option>)}</select>
                <input type="number" data-field="dayOfMonth" data-needs="dayOfMonth" min="1" max="31" value="1" aria-label="day of month" hidden />
                <input type="date" data-field="date" data-needs="date" aria-label="date" hidden />
              </td>
              <td><input type="time" data-field="start" value="16:00" step="900" aria-label="start time" /></td>
              <td><input type="number" data-field="durationMinutes" min="0" step="5" value="60" aria-label="duration in minutes" /></td>
              <td><select data-field="category" aria-label="category">{categoryRows.map((category) => <option value={category.key}>{category.label}</option>)}</select></td>
              <td><button type="button" class="remove-appointment" aria-label="remove commitment">×</button></td>
              </tr>
            </tbody>
          </table>
          <div class="button-row commit-row"><button type="button" id="addAppointmentButton">Add commitment</button><span class="muted" id="appointmentEntryStatus"></span></div>
          <div class="committed-list" id="appointmentList" data-kind="commitments"></div>
        </div>
        <div class="tasks-editor">
          <h3 class="editor-heading">Tasks <span class="muted">— a day, no clock time</span></h3>
          <table class="appointments-table tasks-table">
            <thead><tr><th scope="col">What</th><th scope="col">Weekdays</th><th scope="col">How often</th><th scope="col">When</th><th scope="col">Minutes</th><th scope="col">Category</th><th scope="col"></th></tr></thead>
            <tbody id="taskEntry"></tbody>
            <tbody id="taskPrototype" hidden>
              <tr class="task-row">
              <td><input type="text" data-field="title" placeholder="e.g. Take out the bins" aria-label="task title" /></td>
              <td class="weekday-strip">{options.weekdays.map((weekday) => (
                <label title={weekday.label}><input type="checkbox" data-field="weekday" value={weekday.id} /> {weekday.label.slice(0, 2)}</label>
              ))}</td>
              <td>
                <select data-field="cadenceKind" aria-label="how often it repeats">{options.appointmentCadences.map((cadence) => <option value={cadence.id} data-needs={cadence.needs}>{cadence.label}</option>)}</select>
                <input type="date" data-field="firstDate" data-needs="firstDate" aria-label="first date it happens" hidden />
                <select data-field="nth" data-needs="nth" aria-label="which weekday of the month" hidden>{options.nthChoices.map((choice) => <option value={choice.id}>{choice.label}</option>)}</select>
                <input type="number" data-field="dayOfMonth" data-needs="dayOfMonth" min="1" max="31" value="1" aria-label="day of month" hidden />
                <input type="date" data-field="date" data-needs="date" aria-label="date" hidden />
              </td>
              <td><select data-field="timeOfDay" aria-label="time of day">{options.timesOfDay.map((time) => <option value={time.id}>{time.label}</option>)}</select></td>
              <td><input type="number" data-field="durationMinutes" min="0" step="5" value="15" aria-label="duration in minutes" /></td>
              <td><select data-field="category" aria-label="category">{categoryRows.map((category) => <option value={category.key}>{category.label}</option>)}</select></td>
              <td><button type="button" class="remove-task" aria-label="remove task">×</button></td>
              </tr>
            </tbody>
          </table>
          <div class="button-row commit-row"><button type="button" id="addTaskButton">Add task</button><span class="muted" id="taskEntryStatus"></span></div>
          <div class="committed-list" id="taskList" data-kind="tasks"></div>
        </div>
      </fieldset>

      <MealPlanEditor face="fortknight" />

      <div class="button-row">
        <button type="submit">Save</button>
      </div>
      <p class="muted" id="buildStatus"></p>
    </form>
    ) : (
      <p class="muted">The app’s data has no questionnaire — run <code>python3 scripts/build.py</code>, then restart the app (<code>npm run dev</code>).</p>
    )}
  </section>
</FaceLayout>

<script>
  import { loadSettings, profileIds, saveSettings, setActiveWeights } from "../../lib/shared/user-settings.js";
  import { activeWeights, answersProblem, defaultAnswers, mealsWithDefaults, pickAnswers, standingAppointmentProblem, taskProblem, userWeightsFromAnswers } from "../../lib/shared/weights-rules.js";
  import { normalizeMealPlan } from "../../lib/shared/meal-plan.js";
  import { describeCadence } from "../../lib/shared/import-document.js";
  import { describeDuration, formatClockTime, localTodayIsoDate, roundUpToGrid } from "../../lib/shared/clock.js";
  import { mountMealPlanEditor } from "../../lib/meal-plan-editor.js";
  import { BUILD_ANSWER_KEYS } from "../../lib/answer-keys.js";
  import { promptProfileName } from "../../lib/profile-naming.js";
  import { withBase } from "../../lib/paths.js";

  const form = document.getElementById("buildForm");
  const status = document.getElementById("buildStatus");
  const planStatus = document.getElementById("planStatus");
  let bundle = null;
  let settings = loadSettings();
  let editor = null;
  let dirty = false;

  // One entry row per kind; "Add" commits it into a compact read-only list (Edit only reveals remove).
  let commitments = [];
  let tasks = [];
  const editing = { commitments: false, tasks: false };

  function element(tagName, className, text) {
    const node = document.createElement(tagName);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function categoryLabel(categoryKey) {
    return bundle.categories.categories[categoryKey]?.label ?? categoryKey;
  }

  function markDirty() {
    dirty = true;
    status.textContent = "Unsaved changes.";
  }

  function updateAppointmentRow(row) {
    const kindSelect = row.querySelector('[data-field="cadenceKind"]');
    const needs = kindSelect.selectedOptions[0]?.dataset.needs || "none";
    for (const field of row.querySelectorAll("[data-needs]")) field.hidden = field.dataset.needs !== needs;
  }

  /** Mount the single entry row of a kind (cloned from its hidden prototype); the row's own remove button is dropped. */
  function mountEntryRow(prototypeId, entryId, defaultCategory) {
    const row = document.querySelector(`#${prototypeId} tr`).cloneNode(true);
    row.querySelector('[data-field="category"]').value = defaultCategory;
    row.querySelector(".remove-appointment, .remove-task")?.closest("td").replaceChildren();
    row.querySelector('[data-field="cadenceKind"]').addEventListener("change", () => updateAppointmentRow(row));
    updateAppointmentRow(row);
    document.getElementById(entryId).replaceChildren(row);
    return row;
  }

  function entryRow(entryId) {
    return document.querySelector(`#${entryId} tr`);
  }

  function readCadence(row) {
    const kind = row.querySelector('[data-field="cadenceKind"]').value;
    const cadence = { kind };
    if (kind === "every-other-week") cadence.firstDate = row.querySelector('[data-field="firstDate"]').value || localTodayIsoDate();
    if (kind === "monthly-nth-weekday") cadence.nth = Number(row.querySelector('[data-field="nth"]').value);
    if (kind === "monthly-date") cadence.dayOfMonth = Number(row.querySelector('[data-field="dayOfMonth"]').value) || 1;
    if (kind === "one-off") cadence.date = row.querySelector('[data-field="date"]').value || localTodayIsoDate();
    return cadence;
  }

  function readEntryCommon(row) {
    return {
      title: row.querySelector('[data-field="title"]').value.trim(),
      weekdays: [...row.querySelectorAll('[data-field="weekday"]:checked')].map((box) => box.value),
      cadence: readCadence(row),
      durationMinutes: roundUpToGrid(Number(row.querySelector('[data-field="durationMinutes"]').value) || 0),
      category: row.querySelector('[data-field="category"]').value,
    };
  }

  function readAppointmentEntry() {
    const row = entryRow("appointmentEntry");
    const { title, weekdays, cadence, durationMinutes, category } = readEntryCommon(row);
    return { title, weekdays, start: row.querySelector('[data-field="start"]').value || "16:00", durationMinutes, category, cadence };
  }

  function readTaskEntry() {
    const row = entryRow("taskEntry");
    return { ...readEntryCommon(row), timeOfDay: row.querySelector('[data-field="timeOfDay"]').value };
  }

  /** After a commit: clear what identifies the item, keep the rest (people add several alike in a row). */
  function resetEntry(row) {
    row.querySelector('[data-field="title"]').value = "";
    for (const box of row.querySelectorAll('[data-field="weekday"]')) box.checked = false;
    row.querySelector('[data-field="title"]').focus();
  }

  function commitEntry(kind) {
    const isCommitment = kind === "commitments";
    const record = isCommitment ? readAppointmentEntry() : readTaskEntry();
    const entryStatus = document.getElementById(isCommitment ? "appointmentEntryStatus" : "taskEntryStatus");
    if (!record.title) { entryStatus.textContent = "Give it a name first."; return; }
    const problem = isCommitment ? standingAppointmentProblem(record, bundle.categories.order, weekdayIds()) : taskProblem(record, bundle.categories.order, weekdayIds());
    if (problem) { entryStatus.textContent = `${problem[0].toUpperCase()}${problem.slice(1)}.`; return; }
    entryStatus.textContent = "";
    (isCommitment ? commitments : tasks).push(record);
    renderCommittedList(kind);
    resetEntry(entryRow(isCommitment ? "appointmentEntry" : "taskEntry"));
    markDirty();
  }

  /** One line per committed item; Edit shows a remove button on each (never inline editing — remove and re-add). */
  function renderCommittedList(kind) {
    const isCommitment = kind === "commitments";
    const container = document.getElementById(isCommitment ? "appointmentList" : "taskList");
    const items = isCommitment ? commitments : tasks;
    container.replaceChildren();
    if (!items.length) {
      container.appendChild(element("p", "muted committed-empty", isCommitment ? "No commitments yet." : "No tasks yet."));
      return;
    }
    const header = element("div", "committed-header");
    header.appendChild(element("span", "muted", `${items.length} ${isCommitment ? "commitment" : "task"}${items.length === 1 ? "" : "s"}`));
    const toggle = element("button", "link-button", editing[kind] ? "Done" : "Edit");
    toggle.type = "button";
    toggle.addEventListener("click", () => { editing[kind] = !editing[kind]; renderCommittedList(kind); });
    header.appendChild(toggle);
    container.appendChild(header);
    const list = element("ul", `committed-items${editing[kind] ? " editing" : ""}`);
    items.forEach((item, index) => {
      const line = element("li");
      const when = isCommitment ? formatClockTime(item.start) : item.timeOfDay;
      const parts = [describeCadence(item.cadence, item.weekdays), when, item.durationMinutes ? describeDuration(item.durationMinutes) : "", categoryLabel(item.category)].filter(Boolean);
      line.appendChild(element("strong", null, item.title));
      line.appendChild(document.createTextNode(` · ${parts.join(" · ")}`));
      if (editing[kind]) {
        const remove = element("button", "remove-committed", "×");
        remove.type = "button";
        remove.setAttribute("aria-label", `remove ${item.title}`);
        remove.addEventListener("click", () => { items.splice(index, 1); renderCommittedList(kind); markDirty(); });
        line.appendChild(remove);
      }
      list.appendChild(line);
    });
    container.appendChild(list);
  }

  function readAppointments() {
    return commitments.map((item) => ({ ...item, weekdays: [...item.weekdays], cadence: { ...item.cadence } }));
  }

  function readTasks() {
    return tasks.map((item) => ({ ...item, weekdays: [...item.weekdays], cadence: { ...item.cadence } }));
  }

  function weekdayIds() {
    return bundle.questionnaire.options.weekdays.map((weekday) => weekday.id);
  }

  /** The profile line: the active profile's name and whether it is saved (switching lives in the nav dropdown). */
  function renderProfileBar() {
    const saved = Boolean(settings.weightsProfiles[settings.activeWeightsId]);
    document.getElementById("profileName").textContent = `Profile ${settings.activeWeightsId}`;
    document.getElementById("profileStatus").textContent = saved ? `— saved (${profileIds(settings).length} on this device)` : "— not saved yet";
  }

  /** The active profile's commitments, tasks and menu into the three editors. */
  function populateFromSettings() {
    settings = loadSettings();
    renderProfileBar();
    const saved = activeWeights(settings);
    const answers = saved?.questionnaire?.answers ?? defaultAnswers(bundle.questionnaire, bundle.categories);
    commitments = (answers.standingAppointments || []).map((appointment) => JSON.parse(JSON.stringify(appointment)));
    tasks = (answers.tasks || []).map((task) => JSON.parse(JSON.stringify(task)));
    editing.commitments = editing.tasks = false;
    renderCommittedList("commitments");
    renderCommittedList("tasks");
    const meals = mealsWithDefaults(answers.meals ?? defaultAnswers(bundle.questionnaire, bundle.categories).meals, bundle.questionnaire).meals;
    const { normalized, problems } = normalizeMealPlan(answers.mealPlan || { items: [] }, meals);
    editor.setMeals(meals);
    editor.setItems(normalized.items);
    editor.render();
    planStatus.textContent = problems.length
      ? `${problems.length === 1 ? "1 stored dish no longer matches your meals and was dropped" : `${problems.length} stored dishes no longer match your meals and were dropped`}: ${problems.join("; ")}.`
      : "";
    dirty = false;
    status.textContent = saved
      ? `Loaded profile ${settings.activeWeightsId}: ${commitments.length} commitment${commitments.length === 1 ? "" : "s"}, ${tasks.length} task${tasks.length === 1 ? "" : "s"}, ${normalized.items.length} dish${normalized.items.length === 1 ? "" : "es"}.`
      : `Profile ${settings.activeWeightsId} is new — add what you have and Save to keep it.`;
  }

  /** The whole answers object at save time: the profile as stored *right now* (another tab, the Questionnaire or
   *  Spoon Feed may have saved meanwhile) with only this page's keys written over it. Re-deriving the weights is
   *  what turns the commitments back into the block-split anchors. */
  async function save() {
    const stored = loadSettings();
    stored.activeWeightsId = settings.activeWeightsId; // the profile shown on this page, not whichever another tab switched to
    const base = activeWeights(stored)?.questionnaire?.answers ?? defaultAnswers(bundle.questionnaire, bundle.categories);
    const own = { standingAppointments: readAppointments(), tasks: readTasks(), mealPlan: { items: editor.getItems() } };
    const answers = { ...base, ...pickAnswers(own, BUILD_ANSWER_KEYS) };
    const problem = answersProblem(answers, bundle.questionnaire, bundle.categories);
    if (problem) { status.textContent = problem; return; }
    const firstSave = !activeWeights(stored);
    try {
      setActiveWeights(stored, userWeightsFromAnswers(answers, bundle, { weightsId: stored.activeWeightsId, epochOverride: stored.epochOverride, answeredAt: localTodayIsoDate() }));
      saveSettings(stored);
    } catch (error) {
      status.textContent = `Not saved: ${error.message}`;
      return;
    }
    settings = stored;
    dirty = false;
    const note = firstSave ? await promptProfileName(settings.activeWeightsId) : "";
    settings = loadSettings();
    document.dispatchEvent(new CustomEvent("fortknight:settings-saved"));
    renderProfileBar();
    status.textContent = `Saved ${commitments.length} commitment${commitments.length === 1 ? "" : "s"}, ${tasks.length} task${tasks.length === 1 ? "" : "s"} and the menu of profile ${settings.activeWeightsId} on this device.${note}`;
  }

  // Switching profiles from the nav dropdown reloads the page: with unsaved edits, ask first (cancel vetoes the switch).
  document.addEventListener("fortknight:profile-switch", (event) => {
    if (!dirty) return;
    if (confirm("You have unsaved changes in this profile — switch anyway and drop them?")) dirty = false;
    else event.preventDefault();
  });
  window.addEventListener("beforeunload", (event) => { if (dirty) event.preventDefault(); });

  if (form) {
    form.addEventListener("submit", (event) => { event.preventDefault(); if (bundle) save(); });
    try {
      const response = await fetch(withBase("bundle.json"));
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      bundle = await response.json();
      mountEntryRow("appointmentPrototype", "appointmentEntry", "health");
      mountEntryRow("taskPrototype", "taskEntry", "operations");
      document.getElementById("addAppointmentButton").addEventListener("click", () => commitEntry("commitments"));
      document.getElementById("addTaskButton").addEventListener("click", () => commitEntry("tasks"));
      editor = mountMealPlanEditor(document.getElementById("mealSections"), {
        dayOptions: bundle.days.order.map((dayKey) => ({ dayKey, label: bundle.days.days[dayKey].label })),
        onChange: markDirty,
      });
      populateFromSettings();
    } catch (error) {
      status.textContent = "Could not load the app’s data — run python3 scripts/build.py, then restart the app (npm run dev).";
      console.error(error);
    }
  }
</script>
