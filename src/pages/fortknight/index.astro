---
// FortKnight's Overview: the thesis front door, and — once the visitor has a seed — their fortnight grid.
//
// The claims below are condensed from docs/thesis.md — this page says what the face argues. That argument
// is also the no-seed state and the no-JS fallback, on purpose: a crawler, a build artefact and a stranger
// all see the front door, because everything personal comes from the visitor's own My Fort seed in
// localStorage. When a seed is there, the script draws a compact grid of the fourteen days ABOVE the front
// door — the seed is the overview, the thesis is the footnote.
//
// It resolves nothing. The seed arrives pre-joined by day key, so the grid shows the seed's own words in
// the seed's own order and links each cell to the day page; myfort.astro's header says why running this
// repository's date evaluator over a seed would be wrong for half the year.
//
// Two actions live under "What is here now", and the order is the argument. The primary one is loading a
// seed: it is what makes this page an Overview. The secondary one is creating a profile, and it exists at
// all only while the questionnaires are placeholders — it writes a real, saved profile rather than only
// making one active, because on this branch there is no questionnaire to do the saving (which is also why
// the nav does not offer "New profile…", src/components/ProfileSwitcher.astro). When the questionnaires
// are real, profile creation moves into them and the button here goes.
import FaceLayout from "../../layouts/FaceLayout.astro";
import MyFortStyles from "../../components/MyFortStyles.astro";
import { facePath } from "../../lib/faces.js";

const myFort = facePath("fortknight", "myfort/");
---
<FaceLayout title="FortKnight" face="fortknight">
  <MyFortStyles />
  <div id="myFortGrid" hidden></div>
  <section class="panel">
    <h1>FortKnight</h1>
    <p class="lede">
      A week is the wrong unit of life, and a calendar is the wrong shape for a plan.
      Decide the proportions; let the schedule be derived.
    </p>

    <h2>What it argues</h2>
    <ul>
      <li>
        <strong>Fourteen days, not seven.</strong> The variant letter alternates every day, so week two is
        the mirror of week one. That is the smallest cycle that can hold both “every day” and “every other
        day” things without one of them lying.
      </li>
      <li>
        <strong>Allocation precedes schedule.</strong> A calendar can answer “what is at 3pm Thursday”. It
        cannot answer “am I spending my life the way I said I would”.
      </li>
      <li>
        <strong>Open time is declared, not left over.</strong> Naming the unclaimed part of the fortnight is
        what stops it being quietly eaten.
      </li>
      <li>
        <strong>The year moves, so the rules move with it.</strong> Season starts are computed — equinox,
        nth weekday, Easter — never typed in. A plan that cannot be recomputed for next year has an expiry
        date.
      </li>
      <li>
        <strong>Your schedule is the most sensitive file you own.</strong> No backend, no accounts, no
        server holding it. This site holds nobody’s schedule.
      </li>
    </ul>

    <h2>What is here now</h2>
    <p>
      <a href={myFort}>My Fort</a> shows a fortnight exported from the Focus Key app: what is being eaten,
      what is booked, and the shape of each day. The seed stays on this device and is never uploaded.
      The planner itself runs on a profile kept on this device; the questionnaires that will build one are
      still being built, so one can be created empty here.
    </p>
    <div class="button-row">
      <a class="button" href={myFort}>Load your seed</a>
      <button type="button" id="createProfileButton" hidden>Create a profile</button>
    </div>
    <p class="muted" id="profileStatus"></p>
    <p class="muted" id="myFortOverviewStatus" role="status" aria-live="polite"></p>
  </section>
</FaceLayout>

<script>
  import { readStoredMyFortSeed } from "../../lib/myfort-seed-access.js";
  import { readableDays } from "../../lib/myfort.js";
  import { element } from "../../lib/myfort-view.js";
  import { facePath } from "../../lib/faces.js";

  // Boot is readStoredMyFortSeed()'s decision, like every seed-fed page. "none" renders nothing extra —
  // the front door below is already the right thing to show. "cleared" and "kept" both only report, in
  // the same spot beside the load link: one says the wreckage was forgotten, the other that an intact but
  // undrawable seed was NOT deleted. Only "seed" draws.
  const container = document.getElementById("myFortGrid");
  const status = document.getElementById("myFortOverviewStatus");

  const stored = readStoredMyFortSeed();
  if (stored.status === "cleared" || stored.status === "kept") {
    status.textContent = stored.reason;
  } else if (stored.status === "seed") {
    // Compact by design: the full panels live on My Fort and on the day pages; here a cell is a label, a
    // focus and the meals, and the whole cell is the link. The classes are myfort-grid-* and global for
    // the same reason as the rest of MyFortStyles.astro — this DOM is built here, not stamped by Astro.
    // The heading is an h2: the prerendered <h1>FortKnight</h1> below is the document's one h1 in every
    // state, seeded or not.
    container.appendChild(element("h2", null, "Your fortnight"));
    const grid = element("div", "myfort-grid");
    for (const day of readableDays(stored.seed)) {
      const cell = element("a", "panel myfort-grid-cell");
      cell.href = facePath("fortknight", `days/${day.dayKey}/`);
      cell.appendChild(element("span", "myfort-grid-day", day.label ?? day.dayKey));
      if (day.mainFocusLabel) cell.appendChild(element("span", "myfort-grid-focus muted", day.mainFocusLabel));
      const meals = day.meals ?? {};
      const named = [["Brunch", meals.brunch], ["Snack", meals.snack], ["Dinner", meals.dinner]]
        .filter(([, dish]) => typeof dish === "string" && dish.length > 0);
      if (named.length) {
        const list = element("ul", "myfort-grid-meals");
        for (const [name, dish] of named) list.appendChild(element("li", null, `${name}: ${dish}`));
        cell.appendChild(list);
      }
      grid.appendChild(cell);
    }
    container.appendChild(grid);
    container.hidden = false;
  }
</script>

<script>
  import { loadSettings, newProfileId, profileIds, saveSettings, setActiveWeights } from "../../lib/shared/user-settings.js";
  import { unusedProfileName } from "../../lib/shared/profile-names.js";
  import { PROFILE_PATH } from "../../lib/faces.js";
  import { withBase } from "../../lib/paths.js";

  // Creating a profile lives here while the questionnaires are placeholders. It writes a real, saved
  // profile rather than only making one active: `createProfile` sets the active id and leaves the saving
  // to a questionnaire, and on this branch there is no questionnaire to do it — which is the whole reason
  // the nav's "New profile…" is not offered (src/components/ProfileSwitcher.astro). The name is rolled for
  // you; you can change it on the Profile page, which is where this lands.
  //
  // The button starts hidden and is only revealed here: it is the one control on the page that does
  // nothing without JavaScript, and a dead button is worse than no button.
  const createButton = document.getElementById("createProfileButton");
  const status = document.getElementById("profileStatus");

  function render() {
    const saved = profileIds(loadSettings());
    createButton.hidden = false;
    status.textContent = saved.length
      ? `${saved.length} profile${saved.length === 1 ? "" : "s"} saved on this device.`
      : "No profile on this device yet.";
  }

  createButton.addEventListener("click", () => {
    const settings = loadSettings(); // re-read: another tab may have saved since this page loaded
    try {
      const id = newProfileId(settings, unusedProfileName([...profileIds(settings), settings.activeWeightsId]));
      setActiveWeights(settings, { id, questionnaire: { answers: {} } });
      saveSettings(settings);
      // withBase, not the bare PROFILE_PATH: it is site-root relative, and from /fortknight/ the bare
      // form would resolve to /fortknight/profile/. FaceLayout builds the nav's link the same way.
      location.href = withBase(PROFILE_PATH);
    } catch (error) {
      status.textContent = error.message;
    }
  });

  render();
</script>
