---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import GameEmbed from '../../components/GameEmbed.astro';
import { publishedPosts } from '../../lib/devlog-posts.js';
import { readGameCatalogs } from '../../lib/games-catalog-files.js';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({
    params: { slug: game.id },
    props: { game },
  }));
}

const { game } = Astro.props;
const { Content } = await render(game);

// Only a playable game has a manifest (readGameCatalogs skips the rest), so only it has a board.
const [catalog] = readGameCatalogs([game]);

const now = new Date();
const relatedPosts = publishedPosts(await getCollection('devlog'), now).filter(
  (post) => post.data.game?.id === game.id
);
---

<BaseLayout title={`${game.data.title} — Be Insiculous`} description={game.data.blurb}>
  <header class="game-header">
    <h1>{game.data.title}</h1>
    <StatusBadge status={game.data.status} />
  </header>
  <p class="blurb">{game.data.blurb}</p>

  <GameEmbed
    src={game.data.wasm}
    title={game.data.title}
    width={game.data.width}
    height={game.data.height}
    screenshot={game.data.screenshots[0]}
    screenshotAlt={game.data.screenshots[0] && `${game.data.title} running in a browser`}
  />

  {
    game.data.editor && (
      <p class="editor-link">
        <a href={`/playground/${game.id}/`}>Open {game.data.title} in the editor — layout only: the rules are compiled in, and nothing you change there persists.</a>
      </p>
    )
  }

  {
    game.data.playgroundProject && (
      <p class="playground-rules">
        Its rules are scripts, editable on the playground: <a class="button secondary" href={`/playground/?project=${game.data.playgroundProject}`}>edit <span class="visually-hidden">{game.data.title}</span> on the playground →</a>
      </p>
    )
  }

  {
    catalog && (
      <section class="achievements">
        <h2>Achievements</h2>
        <p class="achievements-intro">
          {catalog.achievements.length} to find in {game.data.title}. They unlock as you play and are
          recorded on this device only — your <a href="/profile/#achievements">profile</a> holds the
          board for every game.
        </p>
        <div id="gameAchievementsBoard" data-catalogs={JSON.stringify([catalog])} />
      </section>
    )
  }

  <article>
    <Content />
  </article>

  <section>
    <h2>Screenshots</h2>
    {
      game.data.screenshots.length > 0 ? (
        <div class="screenshots">
          {game.data.screenshots.map((shot) => (
            <img src={shot} alt={`${game.data.title} screenshot`} loading="lazy" />
          ))}
        </div>
      ) : (
        <p class="empty">No screenshots yet.</p>
      )
    }
  </section>

  <section>
    <h2>Devlog</h2>
    {
      relatedPosts.length > 0 ? (
        <ul class="post-links">
          {relatedPosts.map((post) => (
            <li>
              <a href={`/devlog/${post.id}/`}>{post.data.title}</a>
              <span class="date">
                {post.data.pubDate.toISOString().slice(0, 10)}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">No devlog posts about this game yet.</p>
      )
    }
  </section>
</BaseLayout>

{
  /* Only a playable game can award an achievement: the watch below polls for the WASM's writes,
     and a game without a wasm build writes nothing. */
  game.data.wasm && (
    <script>
      import { maybePromptForProfile, renderAchievementsBoard, totalAchievementCount } from "../../lib/achievements.js";
      import { loadGameUnlocks } from "../../lib/games-achievements.js";
      import { readEmbeddedCatalogs } from "../../lib/games-catalog.js";

      // The WASM writes unlocks to localStorage mid-play, and a write from this same document
      // fires no storage event — so this page, the only place an achievement can arrive during a
      // session, polls every 5s (and on visibilitychange, because a backgrounded tab's timers are
      // throttled exactly when the person alt-tabs back to check). Each check does two things:
      // redraws this game's board when its recorded unlocks have changed, and — when the page
      // opened with nothing recorded anywhere — offers the once-ever create-profile prompt the
      // first time anything is. The interval is cleared on pagehide so a page held in the
      // back/forward cache does not keep polling, and started again on pageshow, which also fires
      // when the page is restored from that cache — a restored page is played on like a fresh one.
      const board = document.getElementById("gameAchievementsBoard");
      const catalogs = readEmbeddedCatalogs(board);
      const gameSlugs = catalogs.map((catalog) => catalog.slug);
      // Ids and dates, not a count: achievements cleared in another tab and a different set of
      // the same size earned since would leave a count unchanged and the board showing stale rows.
      const recordedUnlocksSignature = () =>
        JSON.stringify(gameSlugs.map((slug) =>
          loadGameUnlocks(slug).map((unlock) => [unlock.id, unlock.unlockedAt?.getTime() ?? null])
        ));

      let shownUnlocksSignature: string | null = null;
      let awaitingFirstAchievement = totalAchievementCount() === 0;
      const check = () => {
        const unlocksSignature = recordedUnlocksSignature();
        if (board && unlocksSignature !== shownUnlocksSignature) {
          renderAchievementsBoard(board, {
            types: ["game"],
            includeLocked: true,
            gameCatalogs: catalogs,
            gameSlugs,
          });
          shownUnlocksSignature = unlocksSignature;
        }
        if (awaitingFirstAchievement && totalAchievementCount() > 0) {
          awaitingFirstAchievement = false;
          maybePromptForProfile();
        }
      };

      let watch: ReturnType<typeof setInterval> | null = null;
      const stopWatching = () => {
        if (watch !== null) {
          clearInterval(watch);
          watch = null;
        }
      };
      // pageshow fires after the first load too, so this is the one place the watch starts.
      window.addEventListener("pageshow", () => {
        stopWatching();
        check();
        watch = setInterval(check, 5000);
      });
      window.addEventListener("pagehide", stopWatching);
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden) check();
      });
      check();
    </script>
  )
}

<style>
  .game-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .game-header h1 {
    margin: 0;
  }

  .blurb {
    font-size: 1.15rem;
    color: var(--text-bright);
    max-width: 40em;
    margin-top: 0.75rem;
  }

  .screenshots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: 1rem;
  }

  .screenshots img {
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .achievements-intro {
    max-width: 42em;
  }

  .editor-link,
  .empty {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  /* The whole sentence is the link, so the global accent would paint the
     loudest line on the page; dim, with a standing underline to stay a link. */
  .editor-link a {
    color: var(--text-dim);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .editor-link a:hover {
    color: var(--text-bright);
  }

  .post-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .post-links .date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    margin-left: 0.75rem;
  }
</style>
