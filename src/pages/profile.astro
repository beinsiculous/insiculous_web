---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfileSwitcher from "../components/ProfileSwitcher.astro";
import { facePath } from "../lib/faces.js";
// This page belongs to beinsiculous.com rather than to either app, so it is a studio page like any other: BaseLayout,
// global.css, the six-link header and the studio footer. Only the widgets it shares with the two faces come from
// elsewhere (src/styles/app-widgets.css) — the panels, the buttons and the workspace file rows.
import "../styles/app-widgets.css";

// Profile (shared by FortKnight and ForkKnife): the active profile (switch, name, Duplicate, Delete) and the
// assistant-workspace downloads. The answers themselves are edited on each face's Questionnaire page (docs/app.md).
// The switcher lives here rather than in the header: BaseLayout has no chrome for it, and ForkKnife hides its own
// header copy on a phone (faces.css) on the promise that this page carries one.
---
<BaseLayout
  title="Profile — Be Insiculous"
  description="Your FortKnight and ForkKnife profile: switch or rename it, and download the file set for your own AI workspace."
>
  <section class="panel">
    <h1>Profile</h1>
    <h2 id="profileHeading"></h2>
    <ProfileSwitcher questionnaireHref={facePath("fortknight", "questionnaire/")} />
    <form class="button-row profile-name-form" id="profileNameForm">
      <label class="inline-field">Name <input type="text" id="profileNameInput" autocomplete="off" required /></label>
      <button type="button" id="regenerateNameButton">Regenerate</button>
      <button type="submit" id="renameProfileButton">Rename</button>
      <span class="muted" id="renameStatus"></span>
    </form>
    <p class="muted" id="profileStatus"></p>
    <div class="button-row" id="profileActions">
      <button type="button" id="duplicateProfileButton">Duplicate as…</button>
      <button type="button" id="deleteProfileButton">Delete</button>
    </div>
    <p class="muted">The name becomes the profile’s id — <code>family</code> gives the weights file <code>weights.family.json</code>. Renaming moves the saved answers under the new id. Profiles are switched from the dropdown above. Both apps share this profile: FortKnight’s answers live on its <a href={facePath("fortknight", "questionnaire/")}>Questionnaire</a> and the fortnight on its <a href={facePath("fortknight")}>Overview</a>; your meals and menu on ForkKnife’s <a href={facePath("forkknife", "questionnaire/")}>Questionnaire</a> and <a href={facePath("forkknife")}>Overview</a>.</p>
  </section>

  <section class="panel">
    <h2>My Fort seed</h2>
    <p class="muted">
      The fortnight exported from the Keep app and loaded into My&nbsp;Fort. It is kept on this device only —
      it was never uploaded and this site holds no copy of it.
    </p>
    <p class="muted" id="seedStatus">Checking…</p>
    <div class="button-row" id="seedActions" hidden>
      <button type="button" id="deleteSeedButton">Delete the seed from this device</button>
    </div>
  </section>

  <section class="panel">
    <h2>Achievements</h2>
    <p class="muted">
      The games keep their scores on the machine you played them on. Collecting them onto a board here is
      not built yet — this is where it will be.
    </p>
  </section>

</BaseLayout>

<script>
  import { deleteProfile, duplicateProfile, loadSettings, profileIds, renameProfile, saveSettings } from "../lib/shared/user-settings.js";
  import { unusedProfileName } from "../lib/shared/profile-names.js";
  import { askProfileName } from "../lib/profile-name-dialog.js";
  import { activeWeights } from "../lib/shared/weights-rules.js";
  import { clearMyFortSeed, describeMyFortSeed } from "../lib/myfort-store.js";

  const elements = {
    seedStatus: document.getElementById("seedStatus"),
    seedActions: document.getElementById("seedActions"),
    deleteSeedButton: document.getElementById("deleteSeedButton"),
    profileHeading: document.getElementById("profileHeading"),
    profileNameForm: document.getElementById("profileNameForm"),
    profileNameInput: document.getElementById("profileNameInput"),
    renameStatus: document.getElementById("renameStatus"),
    profileStatus: document.getElementById("profileStatus"),
    profileActions: document.getElementById("profileActions"),
    regenerateNameButton: document.getElementById("regenerateNameButton"),
    duplicateProfileButton: document.getElementById("duplicateProfileButton"),
    deleteProfileButton: document.getElementById("deleteProfileButton"),
  };

  function renderProfile() {
    const settings = loadSettings();
    const active = activeWeights(settings);
    const savedCount = profileIds(settings).length;
    elements.profileHeading.textContent = settings.activeWeightsId;
    elements.profileNameInput.value = settings.activeWeightsId;
    // Duplicate/Delete need a saved profile.
    elements.duplicateProfileButton.hidden = !active;
    elements.deleteProfileButton.hidden = !active;
    if (active) {
      elements.profileStatus.textContent = `Saved on this device${active.questionnaire?.answeredAt ? ` (answers from ${active.questionnaire.answeredAt})` : ""}${savedCount > 1 ? `; ${savedCount} profiles saved` : ""}.`;
    } else if (savedCount) {
      elements.profileStatus.textContent = `Not saved yet — answer the Questionnaire and Save. ${savedCount} other profile${savedCount === 1 ? " is" : "s are"} saved on this device; switch with the dropdown above.`;
    } else {
      elements.profileStatus.textContent = "No profile saved yet — answer the Questionnaire and Save; the Overview shows default answers until then.";
    }
  }

  /** Re-read the device's settings (another tab may have saved), run the operation, save; errors go to the status line. */
  function withProfiles(operation, statusElement = elements.profileStatus) {
    const settings = loadSettings();
    try {
      operation(settings);
      saveSettings(settings);
      return true;
    } catch (error) {
      statusElement.textContent = error.message;
      return false;
    }
  }

  elements.regenerateNameButton.addEventListener("click", () => {
    const current = loadSettings();
    // Every id newProfileId would reject, the active one included even when it is not saved yet —
    // otherwise a roll can hand back the name already in force and Rename silently does nothing.
    elements.profileNameInput.value = unusedProfileName([...profileIds(current), current.activeWeightsId]);
    elements.renameStatus.textContent = "";
  });

  elements.profileNameForm.addEventListener("submit", (event) => {
    event.preventDefault();
    const current = loadSettings();
    const name = elements.profileNameInput.value;
    elements.renameStatus.textContent = "";
    if (!name.trim() || name.trim() === current.activeWeightsId) return;
    // The name is the id (weights.<id>.json): everything saved under the old id moves; the nav dropdown follows on reload.
    if (withProfiles((settings) => renameProfile(settings, settings.activeWeightsId, name), elements.renameStatus)) location.reload();
  });
  elements.duplicateProfileButton.addEventListener("click", async () => {
    const current = loadSettings();
    const takenIds = [...profileIds(current), current.activeWeightsId];
    const copied = await askProfileName({
      title: `Name the copy of ${current.activeWeightsId}`,
      name: unusedProfileName(takenIds),
      takenIds,
      confirmLabel: "Duplicate",
      canCancel: true,
      commit(typed) {
        const settings = loadSettings(); // re-read here: the dialog may have been open a while
        duplicateProfile(settings, settings.activeWeightsId, typed);
        saveSettings(settings);
        return settings.activeWeightsId;
      },
    });
    if (copied) location.reload();
  });
  elements.deleteProfileButton.addEventListener("click", () => {
    const current = loadSettings();
    if (!confirm(`Delete profile ${current.activeWeightsId} from this device? Its saved answers are removed.`)) return;
    if (withProfiles((settings) => deleteProfile(settings, settings.activeWeightsId))) {
      const remaining = loadSettings();
      // Reload either way while the faces are placeholders: with no profile left there is nowhere to send
      // someone to make one, and this page's own empty state is the honest answer.
      location.reload();
    }
  });
  /** What is on this device, never what is in it: whether a seed is here and when it was exported. */
  function renderSeed() {
    const { present, exportedAt } = describeMyFortSeed();
    elements.seedActions.hidden = !present;
    elements.seedStatus.textContent = present
      ? `A seed is stored on this device${exportedAt ? `, exported ${exportedAt}` : ""}.`
      : "No seed on this device yet. Export one from Keep and load it on My Fort.";
  }

  elements.deleteSeedButton.addEventListener("click", () => {
    if (!confirm("Delete the My Fort seed from this device? Load it again to bring it back.")) return;
    clearMyFortSeed();
    renderSeed();
  });

  renderProfile();
  renderSeed();
</script>
