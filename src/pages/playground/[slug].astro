---
import { getCollection } from 'astro:content';
import AppLayout from '../../layouts/AppLayout.astro';
import PlaygroundToolbar from '../../components/PlaygroundToolbar.astro';
import PlaygroundHelp from '../../components/PlaygroundHelp.astro';
import GameEmbed from '../../components/GameEmbed.astro';

export async function getStaticPaths() {
  const games = await getCollection('games');
  const editorGames = games.filter((game) => game.data.editor);
  return editorGames.map((game) => ({
    params: { slug: game.id },
    props: {
      game,
      otherEditorGames: editorGames
        .filter((other) => other.id !== game.id)
        .sort((first, second) => first.data.order - second.data.order)
        .map((other) => ({ slug: other.id, title: other.data.title })),
    },
  }));
}

const { game, otherEditorGames } = Astro.props;

// The editor enlarges any window under its usable minimum (the engine's
// crates/editor_integration/src/constants.rs, MIN_EDITOR_WINDOW_WIDTH and
// MIN_EDITOR_WINDOW_HEIGHT), and winit sizes its canvas from that config — so
// the placeholder must carry the CLAMPED size, not the game's own. The engine's
// build_wasm.sh test page derives it the same way from the same constants.
const canvasWidth = Math.max(game.data.width ?? 800, 1024);
const canvasHeight = Math.max(game.data.height ?? 600, 720);

// A game with no still of its own takes GameEmbed's default — Pong, with Pong's alt.
const screenshot = game.data.screenshots[0];
---

<AppLayout
  title={`${game.data.title} in the editor — Be Insiculous`}
  description={`${game.data.title} running inside the Insiculous 2D scene editor, in the browser.`}
>
  <Fragment slot="heading">{game.data.title} in the editor</Fragment>
  <PlaygroundToolbar slot="bar" projectControls={false}>
    <nav class="editor-pages" aria-label="Editor pages">
      <a href="/playground/">Web Playground</a>
      {otherEditorGames.map((other) => <a href={`/playground/${other.slug}/`}>{other.title}</a>)}
    </nav>
  </PlaygroundToolbar>

  <PlaygroundHelp
    projectHelp={false}
    saveLine="save the scene for this session only — a reload brings the game’s own layout back"
  >
    <p>
      The real Rust game, running inside the engine’s scene editor. Its entities are live and
      editable — select them, move them, press play — but the rules are compiled in, and nothing
      persists: reload the page and the game is itself again.
    </p>
    <p>
      Click the canvas to focus it, then <kbd>F5</kbd> to play the real game.
    </p>
    <h3>Elsewhere</h3>
    <ul class="links">
      <li><a href={`/games/${game.id}/`}>Play {game.data.title}</a></li>
      <li><a href="/playground/">The Web Playground</a> — the editor with its own projects</li>
    </ul>
  </PlaygroundHelp>

  <GameEmbed
    src={game.data.editor}
    title={game.data.title}
    canvasLabel="scene editor canvas; focus it to edit and play"
    width={canvasWidth}
    height={canvasHeight}
    fill
    screenshot={screenshot}
    screenshotAlt={screenshot && `${game.data.title} running in a browser`}
  />
</AppLayout>

<style>
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  kbd {
    background: var(--surface);
    border: 1px solid var(--border-bright);
    border-radius: 3px;
    padding: 0.1rem 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .editor-pages {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
</style>
